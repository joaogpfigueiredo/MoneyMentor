kg:despesa-variavel a fl:Concept ;
    rdfs:label "despesa variável"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/identificar-rendimentos-e-despesas> ;
    fl:definition "Despesa que depende do consumo mensal e pode ser alterada, reduzida ou eliminada."@pt,
        "Despesa que varia ao longo do tempo, como comissões recebidas em função das vendas realizadas."@pt ;
    fl:hasTopic fl:t-despesas-rendimentos,
        fl:t-necessidades-desejos .

kg:direito-a-resolucao-do-contrato a fl:Right ;
    rdfs:label "direito à resolução do contrato"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
