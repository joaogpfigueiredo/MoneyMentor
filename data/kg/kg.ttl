    rdfs:label "taxa fixa"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/simples> ;
    fl:definition "Taxa de juro aplicável ao depósito que é conhecida no momento da contratação e mantém-se inalterada ao longo da vida da aplicação."@pt .

kg:taxa-nominal-aplicada a fl:Concept ;
    rdfs:label "taxa nominal aplicada"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar> ;
    fl:definition "Taxa de juro aplicada ao crédito, que deve ser informada ao cliente no extrato."@pt .

kg:transferencia-de-gestao-do-fundo a fl:Concept ;
    rdfs:label "transferência de gestão do fundo"@pt ;
