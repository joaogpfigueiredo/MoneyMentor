kg:seguro-facultativo a fl:Concept ;
    rdfs:label "seguro facultativo"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/fazer-um-seguro-0> ;
    fl:definition "Seguro que é opção do tomador do seguro celebrá-lo ou não."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:sepa a fl:Concept ;
    rdfs:label "SEPA"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/debitos-diretos> ;
    fl:definition "Modelo de pagamentos que permite a qualquer cliente localizado no espaço SEPA efetuarem pagamentos por débito direto, em euros, através de uma única conta."@pt ;
    fl:hasTopic fl:t-meios-pagamento .

kg:servico-de-mera-execucao-de-orden a fl:Concept ;
    rdfs:label "serviço de mera execução de ordens"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/perfil-do-investidor> ;
    fl:definition "Serviço prestado pela entidade financeira quando o investidor inicia a aquisição de um produto não complexo, sem que a entidade avalie a adequação do produto."@pt ;
    fl:hasTopic fl:t-informacao-financeira,
        fl:t-responsabilidades-credito ;
    fl:relatedTo kg:servico-de-aconselhamento .

kg:simulacao-de-sinistro a fl:Risk ;
    rdfs:label "simulação de sinistro"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/seguros-1> ;
    fl:definition "Ação de provocar intencionalmente um sinistro para obter um benefício ilegal, como a indemnização."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:sistema-de-governacao a fl:Concept ;
    rdfs:label "sistema de governação"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Estrutura e processos de tomada de decisão nas entidades gestoras de fundos de pensões, incluindo a atuação com os participantes e beneficiários."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:sistema-de-pagamento-direto a fl:Concept ;
    rdfs:label "sistema de pagamento direto"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Sistema em que a empresa de seguros paga diretamente aos prestadores de serviços convencionados."@pt ;
    fl:hasTopic fl:t-seguros .

kg:sistema-de-reembolso a fl:Concept ;
    rdfs:label "sistema de reembolso"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Sistema em que o segurado paga as despesas diretamente aos prestadores e depois é reembolsado pela empresa de seguros."@pt ;
    fl:hasTopic fl:t-seguros .

kg:situacao-profissional a fl:Concept ;
    rdfs:label "situação profissional"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/avaliacao-da-solvabilidade> ;
    fl:definition "Elemento considerado na avaliação da solvabilidade do cliente bancário."@pt ;
    fl:hasTopic fl:t-necessidades-capacidades .

kg:tan-maxima a fl:Concept ;
    rdfs:label "tan máxima"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro-no-credito-aos-consumidores> ;
    fl:definition "Taxa Anual Nominal máxima aplicável aos contratos de crédito aos consumidores."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:taxa-de-inflacao-homologa a fl:Concept ;
    rdfs:label "taxa de inflação homóloga"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/avaliar-os-efeitos-da-inflacao> ;
    fl:definition "Variação do IPC entre o mês corrente e o mesmo mês do ano anterior, usada para medir a evolução da inflação em relação ao mesmo período do ano anterior."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:taxa-de-inflacao-media a fl:Concept ;
    rdfs:label "taxa de inflação média"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/avaliar-os-efeitos-da-inflacao> ;
    fl:definition "Média da variação do IPC dos últimos 12 meses relativamente à média dos 12 meses imediatamente anteriores, usada para medir a inflação do ano."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:taxa-de-inflacao-mensal a fl:Concept ;
    rdfs:label "taxa de inflação mensal"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/avaliar-os-efeitos-da-inflacao> ;
    fl:definition "Variação do IPC entre o mês corrente e o mês anterior, usada para medir a inflação mês a mês."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:taxa-de-juro-anual-nominal a fl:Concept ;
    rdfs:label "taxa de juro anual nominal"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar> ;
    fl:definition "Taxa de juro anual nominal (TAN), com as suas características e componentes, indicada nas fichas de informação normalizada."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:taxa-nominal a fl:Concept ;
    rdfs:label "taxa nominal"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-renegociar-ou-reembolsar-antecipadamente> ;
    fl:definition "Taxa aplicável ao contrato de crédito, que pode ser fixa ou variável, influenciando a comissão de reembolso antecipado."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:teletrabalho a fl:Concept ;
    rdfs:label "teletrabalho"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Trabalho realizado à distância, com o trabalhador em local diferente do local habitual de trabalho, mas sujeito ao controlo do empregador."@pt ;
    fl:hasTopic fl:t-sistema-financeiro .

kg:tempo-de-poupanca a fl:Concept ;
    rdfs:label "tempo de poupança"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/en/simulador-da-poupanca> ;
    fl:definition "Duração do período durante o qual a poupança é feita."@pt ;
    fl:hasTopic fl:t-planeamento .

kg:tolerancia-ao-risco a fl:Concept ;
    rdfs:label "tolerância ao risco"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/perfil-do-investidor> ;
    fl:definition "Capacidade do investidor de assumir perdas em função do seu perfil de risco e da perda máxima que está disposto a assumir."@pt ;
    fl:hasTopic fl:t-informacao-financeira,
        fl:t-risco-incerteza ;
    fl:relatedTo kg:perfil-de-investidor .

kg:trabalhador-independente a fl:Concept ;
    rdfs:label "trabalhador independente"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Pessoa que exerce atividade por conta própria, dispensada de seguro de acidentes de trabalho em certas condições."@pt ;
    fl:hasTopic fl:t-seguros .

kg:trabalhador-por-conta-de-outrem a fl:Concept ;
    rdfs:label "trabalhador por conta de outrem"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Trabalhador que presta serviços a uma entidade empregadora, em regime de contrato de trabalho."@pt ;
    fl:hasTopic fl:t-seguros .

kg:transferencia-de-emprestimo a fl:Concept ;
    rdfs:label "transferência de empréstimo"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-reembolsar-e-transferir> ;
    fl:definition "Processo de transferência de um empréstimo de uma instituição para outra, com fornecimento de informações em 10 dias úteis."@pt ;
    fl:hasTopic fl:t-emprestimos .

kg:tribunal a fl:Right ;
    rdfs:label "tribunais"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/servi%C3%A7os/reclama%C3%A7%C3%B5es/meios-de-resolu%C3%A7%C3%A3o-de-lit%C3%ADgios> ;
    fl:definition "Instituição onde os consumidores podem recorrer quando o CIMPAS não pode resolver o litígio."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:troca-de-nota-deteriorada a fl:Right ;
    rdfs:label "troca de nota deteriorada"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/numerario> ;
    fl:definition "É possível trocar uma nota deteriorada no Banco de Portugal, sem qualquer custo."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:unidade-economica a fl:Concept ;
    rdfs:label "unidade económica"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-tipos-de-credito> ;
    fl:definition "Condição em que o contrato de crédito está coligado a outro contrato, como compra e venda ou prestação de serviços, e ambos constituem uma unidade económica."@pt ;
    fl:hasTopic fl:t-emprestimos .

kg:valor-atual-das-responsabilidade-por-servico-passado a fl:Concept ;
    rdfs:label "valor atual das responsabilidades por serviços passados"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Montante que representa o valor dos serviços já prestados pelo participante, incluindo os direitos adquiridos."@pt ;
    fl:hasTopic fl:t-necessidades-capacidades .

kg:variacao-no-valor-das-prestacao a fl:Risk ;
    rdfs:label "variações no valor das prestações"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/avaliacao-da-solvabilidade> ;
    fl:definition "Circunstância futura que pode impactar a capacidade do cliente bancário para cumprir as obrigações de um contrato de crédito."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:volume-de-negociacao a fl:Concept ;
    rdfs:label "volume de negociação"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/acoes> ;
    fl:definition "Indica a liquidez das ações, sendo maior quando o volume de transações é maior."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:volume-medio-de-transacao-diaria a fl:Concept ;
    rdfs:label "volume médio de transações diárias"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/acoes> ;
    fl:definition "Métrica usada para medir a liquidez das ações."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:apolice a fl:Concept ;
    rdfs:label "apólice"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Documento que regista o contrato de seguro e que identifica o segurado e o tomador do seguro."@pt .

kg:avaliacao-de-imovel a fl:Concept ;
    rdfs:label "avaliação de imóvel"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/garantias> ;
    fl:definition "Processo de avaliação do imóvel realizado por perito avaliador independente, registado junto da Comissão do Mercado de Valores Mobiliários."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-emprestimos .

kg:capitalizacao-de-juro a fl:Concept ;
    rdfs:label "capitalização de juros"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/atraso-no-pagamento>,
        <https://clientebancario.bportugal.pt/pt-pt/simples>,
        <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro> ;
    fl:definition "Processo de acumulação dos juros ao capital, que pode ser automática ou opcional."@pt,
        "Processo de aplicação de novos juros sobre os juros já cobrados, permitida apenas em casos específicos como reestruturação ou consolidação de créditos."@pt,
        "Processo em que os juros obtidos em cada período são adicionados ao capital inicial, constituindo um novo capital que também é remunerado."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:taxa-de-juro-composto .

kg:comissao-de-pagamento a fl:Cost ;
    rdfs:label "comissão de pagamento"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar> ;
    fl:definition "Valor cobrado pelo cliente na próxima prestação de um contrato de crédito."@pt .

kg:comissao-de-renegociacao a fl:Cost ;
    rdfs:label "comissão de renegociação"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-renegociar>,
        <https://clientebancario.bportugal.pt/pt-pt/gestao-do-incumprimento>,
        <https://clientebancario.bportugal.pt/pt-pt/prevencao-do-incumprimento> ;
    fl:definition "Comissão cobrada pela instituição em consequência da renegociação de contratos de crédito."@pt,
        "Comissão cobrada pela instituição em consequência da renegociação de um contrato de crédito."@pt,
        "Valor cobrado pela instituição de crédito no âmbito da renegociação de contratos de crédito, que não pode ser cobrado."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:incumprimento-de-credito .

kg:comunicacao-por-escrito a fl:Right ;
    rdfs:label "comunicação por escrito"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/provedor-seguros> ;
    fl:definition "O provedor deve comunicar por escrito ao reclamante os resultados da apreciação da reclamação, incluindo fundamentação e recomendações."@pt ;
    fl:hasTopic fl:t-informacao-financeira,
        fl:t-prevencao-fraude .

kg:condicao-especial a fl:Concept ;
    rdfs:label "condições especiais"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro>,
        <https://www.todoscontam.pt/pt-pt/apolice-de-seguro-0> ;
    fl:definition "Conjunto de cláusulas que complementam ou especificam as condições gerais, normalmente coberturas adicionais que são realmente contratadas."@pt .

kg:condicao-geral a fl:Concept ;
    rdfs:label "condições gerais"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro>,
        <https://www.todoscontam.pt/pt-pt/apolice-de-seguro-0> ;
    fl:definition "Conjunto de cláusulas contratuais previamente elaboradas e apresentadas pela seguradora, que definem as coberturas e exclusões gerais e os direitos e obrigações das partes."@pt,
        "Conjunto de cláusulas contratuais previamente elaboradas pelo segurador, que definem as coberturas e exclusões gerais e os direitos e obrigações das partes."@pt .

kg:condicao-particular a fl:Concept ;
    rdfs:label "condições particulares"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro>,
        <https://www.todoscontam.pt/pt-pt/apolice-de-seguro-0> ;
    fl:definition "Conjunto de cláusulas que adaptam o contrato à situação concreta de um tomador do seguro, identificando as coberturas escolhidas, valores do capital seguro, franquias, beneficiários, etc."@pt,
        "Conjunto de cláusulas que adaptam o contrato à situação concreta do tomador do seguro, incluindo coberturas escolhidas, valores do capital seguro, franquias, beneficiários, etc."@pt .

kg:conta-corrente-bancaria a fl:Product ;
    rdfs:label "contas correntes bancárias"@pt ;
    skos:altLabel "conta corrente bancária"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0>,
        <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-tipos-de-credito> ;
    fl:definition "Conta bancária que permite ao cliente realizar operações de depósito e saque, garantida por hipoteca ou outro direito relativo a imóveis."@pt ;
    fl:hasCost kg:comissao-de-manutencao,
        kg:juro ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-emprestimos .

kg:conta-poupanca-condominio a fl:Product ;
    rdfs:label "conta poupança-condomínio"@pt ;
    skos:altLabel "depósito a prazo para condomínio"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-sao-e-tipos-de-depositos> ;
    fl:hasCost kg:comissao-de-manutencao ;
    fl:hasTopic fl:t-aplicacoes-poupanca,
        fl:t-custos-credito .

kg:conta-poupanca-habitacao a fl:Product ;
    rdfs:label "conta poupança-habitação"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/garantia-de-depositos>,
        <https://clientebancario.bportugal.pt/pt-pt/o-que-sao-e-tipos-de-depositos> ;
    fl:definition "Conta de depósito a prazo com finalidade específica para a aquisição ou beneficiação de habitação própria, que pode proporcionar acesso a crédito."@pt,
        "Conta de poupança associada à habitação, com características específicas."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca ;
    fl:relatedTo kg:deposito-a-prazo .

kg:credito-automovel-com-reserva-de-propriedade a fl:Product ;
    rdfs:label "crédito automóvel com reserva de propriedade"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-tipos-de-credito> ;
    fl:definition "Empréstimo para aquisição de automóvel em que se regista um direito sobre o automóvel (reserva de propriedade) na conservatória competente."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-emprestimos .

kg:credito-automovel-sem-reserva-de-propriedade a fl:Product ;
    rdfs:label "crédito automóvel sem reserva de propriedade"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-tipos-de-credito> ;
    fl:definition "Empréstimo para aquisição de automóvel em que não há lugar à reserva de propriedade do carro. A instituição pode exigir outras garantias, como uma fiança."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-emprestimos .

kg:custo-de-desinvestimento a fl:Cost ;
    rdfs:label "custos de desinvestimento"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es>,
        <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Custos suportados pelo segurador comprovadamente, em caso de resolução do contrato."@pt,
        "Despesas suportadas pela entidade gestora que podem ser deduzidas na devolução do valor."@pt ;
    fl:hasTopic fl:t-seguros .

kg:declaracao-medica a fl:Concept ;
    rdfs:label "declaração médica"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/direito-ao-esquecimento> ;
    fl:definition "Documento que comprova a superação ou mitigação de uma situação de risco agravado de saúde ou de deficiência."@pt,
        "Documento que comprova que uma situação de risco agravado de saúde ou deficiência foi superada ou mitigada."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:despesa-necessaria a fl:Concept ;
    rdfs:label "despesa necessária"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/identificar-rendimentos-e-despesas> ;
    fl:definition "Pagamento de bens e serviços considerados essenciais, como alimentação, habitação, saúde e educação."@pt ;
    fl:hasTopic fl:t-despesas-rendimentos,
        fl:t-necessidades-desejos .

kg:despesa-superflua a fl:Concept ;
    rdfs:label "despesa supérflua"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/identificar-rendimentos-e-despesas> ;
    fl:definition "Pagamento de bens e serviços destinados à satisfação de desejos, como a aquisição de novos modelos de vestuário."@pt ;
    fl:hasTopic fl:t-despesas-rendimentos,
        fl:t-necessidades-desejos .

kg:direito-de-livre-resolucao a fl:Right ;
    rdfs:label "direito de livre resolução"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/contratacao-distancia> ;
    fl:definition "Direito do cliente de desistir do contrato à distância durante 14 dias após a celebração, sem justificação e sem penalização."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito ;
    fl:relatedTo kg:imposto-do-selo,
        kg:juro-vencido,
        kg:reembolso-antecipado .

kg:direito-de-opcao a fl:Right ;
    rdfs:label "direito de opção"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Direito do beneficiário de escolher a forma de pagamento da pensão dentro de 60 dias após receber informação."@pt ;
    fl:hasTopic fl:t-informacao-financeira,
        fl:t-responsabilidades-credito .

kg:documento-de-identificacao-valido a fl:Concept ;
    rdfs:label "documento de identificação válido"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Documento emitido por autoridade pública competente, com fotografia e assinatura do titular, necessário para a identificação do cliente."@pt,
        "Documento que comprova a identidade do cliente, como o cartão de cidadão."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:doenca-preexistente a fl:Concept ;
    rdfs:label "doença preexistente"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Circunstância clínica presente antes da data de início do seguro, com diagnóstico inequívoco e conhecimento prévio do segurado."@pt,
        "Doenças conhecidas do segurado à data da celebração do contrato, que podem estar cobertas se não forem excluídas expressamente."@pt ;
    fl:hasTopic fl:t-seguros .

kg:emprestimo-a-particular a fl:Product ;
    rdfs:label "empréstimo a particulares"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-tipos-de-credito> ;
    fl:definition "Empréstimo com montante entre 200 e 75 000 euros, concedido a particulares."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-emprestimos .

kg:emprestimo-para-aquisicao-ou-construcao-de-nova-habitacao a fl:Product ;
    rdfs:label "empréstimo para aquisição ou construção de nova habitação"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Empréstimo concedido quando a habitação anterior se torna inadequada por alteração do agregado familiar ou transferência de trabalho."@pt ;
    fl:hasTopic fl:t-emprestimos,
        fl:t-responsabilidades-credito ;
    fl:relatedTo kg:credito-bonificado-para-pessoa-com-deficiencia,
        kg:racio-financeiro-de-garantia .

kg:emprestimo-para-habitacao a fl:Product ;
    rdfs:label "empréstimo para habitação"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Empréstimo concedido para a aquisição, ampliação, construção ou realização de obras de conservação de habitação própria permanente."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-emprestimos ;
    fl:relatedTo kg:acumulacao-de-emprestimo,
        kg:seguro-de-vida .

kg:encargo-com-o-pagamento-de-emprestimo a fl:Concept ;
    rdfs:label "encargos com o pagamento de empréstimos"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/planear-o-orcamento-familiar> ;
    fl:definition "Custo associado ao pagamento de empréstimos que deve ser avaliado na situação financeira pessoal."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-responsabilidades-credito .

kg:encerramento-da-conta-de-origem a fl:Concept ;
    rdfs:label "encerramento da conta de origem"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/mudanca-de-conta> ;
    fl:definition "Ação de fechar a conta antiga após a mudança para uma nova conta, que pode ser feita gratuitamente ou com prazo máximo de um mês."@pt,
        "Ação de fechar a conta de origem após a conclusão do processo de mudança de conta."@pt ;
    fl:hasTopic fl:t-contas-bancarias .

kg:garantia-publica-do-estado a fl:Concept ;
    rdfs:label "garantia pública do Estado"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Fiança prestada pelo Estado para viabilizar a concessão de crédito para aquisição da primeira habitação própria permanente, com limite de 15% do valor da transação do imóvel."@pt ;
    fl:hasTopic fl:t-emprestimos,
        fl:t-responsabilidades-credito .

kg:indexante a fl:Concept ;
    rdfs:label "indexante"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro-no-credito-habitacao> ;
    fl:definition "Valor ou índice utilizado como referência para calcular a taxa de juro variável, como o Euribor."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-responsabilidades-credito .

kg:indice-de-preco-no-consumidor-ipc a fl:Concept ;
    rdfs:label "índice de preços no consumidor (IPC)"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/avaliar-os-efeitos-da-inflacao> ;
    fl:definition "Índice que mede a variação dos preços de um cabaz de bens e serviços habitualmente consumidos pelas famílias residentes em Portugal."@pt ;
    fl:hasTopic fl:t-informacao-financeira ;
    fl:relatedTo kg:cabaz-de-compra .

kg:informacao-ao-reclamante a fl:Right ;
