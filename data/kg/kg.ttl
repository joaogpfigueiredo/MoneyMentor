    fl:hasTopic fl:t-seguros ;
    fl:relatedTo kg:seguro-de-saude .

kg:prorrogacao-de-contrato a fl:Concept ;
    rdfs:label "prorrogação de contrato"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Extensão automática do contrato de seguro por novos períodos de um ano, salvo acordo em contrário."@pt .

kg:prova-de-rendimento a fl:Cost ;
    rdfs:label "prova de rendimento"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Requisito para a empresa de seguros verificar se a retribuição declarada é igual ou superior ao mínimo legal, podendo exigir prova de rendimento em caso de valor superior ao mínimo."@pt .

kg:publicidade-a-fundo-de-pensao a fl:Concept ;
    rdfs:label "publicidade a fundos de pensões"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Publicidade efetuada pelas entidades gestoras de fundos de pensões, sujeita à lei geral e a regulamentação específica."@pt ;
    fl:hasTopic fl:t-informacao-financeira ;
    fl:relatedTo kg:fundo-de-pensao-aberto .

kg:queda-de-raio a fl:Risk ;
    rdfs:label "queda de raio"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-habita%C3%A7%C3%A3o> ;
    fl:hasTopic fl:t-seguros .

kg:racio-dsti a fl:Concept ;
    rdfs:label "rácio DSTI"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/avaliacao-da-solvabilidade> ;
    fl:definition "Rácio entre o montante total das prestações mensais dos empréstimos e o rendimento mensal líquido do cliente, que não deve exceder 45%."@pt .

kg:racio-loan-to-value a fl:Concept ;
    rdfs:label "rácio loan-to-value"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro-no-credito-habitacao> ;
    fl:definition "Relação entre o valor do empréstimo e o valor do imóvel, utilizada para avaliar o risco de crédito."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-responsabilidades-credito .

kg:reducao-do-montante-do-credito a fl:Right ;
    rdfs:label "redução do montante do crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-tipos-de-credito> ;
    fl:definition "Redução do montante do crédito em montante igual ao da redução do preço do bem ou do serviço em causa."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito ;
    fl:relatedTo kg:resolucao-do-contrato-de-credito .

kg:reembolso-de-deposito a fl:Right ;
    rdfs:label "reembolso de depósitos"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/garantia-de-depositos> ;
    fl:definition "Direito do cliente de ser reembolsado os depósitos quando a instituição de crédito fica indisponível para reembolsar."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito ;
    fl:relatedTo kg:garantia-de-deposito .

kg:reembolso-parcial a fl:Right ;
    rdfs:label "reembolso parcial"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-reembolsar-e-transferir> ;
    fl:definition "Reembolso de parte do capital em dívida, feito na data do pagamento da prestação, com aviso de pelo menos sete dias úteis à instituição de crédito."@pt .

kg:reembolso-total a fl:Right ;
    rdfs:label "reembolso total"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-reembolsar-e-transferir> ;
    fl:definition "Reembolso da totalidade do capital em dívida antes do prazo estipulado no contrato, com aviso de pelo menos 10 dias úteis à instituição de crédito."@pt .

kg:refinanciamento-de-credito a fl:Concept ;
    rdfs:label "refinanciamento de crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/prevencao-do-incumprimento> ;
    fl:definition "Reestruturação de um contrato de crédito para melhorar as condições de pagamento."@pt .

kg:refinanciamento-do-credito a fl:Concept ;
    rdfs:label "refinanciamento do crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/prevencao-do-incumprimento> ;
    fl:definition "Celebração de um novo contrato de crédito com a finalidade de substituir o contrato original, sem aumento da taxa de juro ou spread."@pt .

kg:remicao-parcial-das-pensao a fl:Concept ;
    rdfs:label "remição parcial das pensões"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Possibilidade de requerer a remição parcial das pensões, em certas condições previstas na lei."@pt .

kg:remuneracao-dos-deposito a fl:Concept ;
    rdfs:label "remuneração dos depósitos"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/direitos-e-deveres-na-contratacao-de-depositos> ;
    fl:definition "Remuneração relativa aos fundos depositados, que o cliente tem direito a receber caso esteja prevista no contrato."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:fundo-de-garantia-de-deposito .

kg:rendibilidade-incerta a fl:Concept ;
    rdfs:label "rendibilidade incerta"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/produtos-financeiros-complexos> ;
    fl:definition "Característica de produtos financeiros complexos, cuja rendibilidade depende da evolução do preço de outros ativos."@pt .

kg:rendimento-certo a fl:Concept ;
    rdfs:label "rendimentos certos"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/determinar-situacao-financeira> ;
    fl:definition "Rendimentos que são previstos com certeza no cálculo da situação financeira."@pt ;
    fl:hasTopic fl:t-despesas-rendimentos,
        fl:t-planeamento .

kg:rendimento-incerto a fl:Concept ;
    rdfs:label "rendimentos incertos"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/determinar-situacao-financeira> ;
    fl:definition "Rendimentos que não são previstos com certeza no cálculo da situação financeira."@pt ;
    fl:hasTopic fl:t-despesas-rendimentos,
        fl:t-planeamento .

kg:renegociacao-do-contrato a fl:Concept ;
    rdfs:label "renegociação do contrato"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-reembolsar-e-transferir> ;
    fl:definition "Alteração dos termos do contrato de empréstimo, que só é possível com acordo entre o cliente bancário e a instituição de crédito."@pt .

kg:renuncia-ao-beneficio-de-excussao-previa a fl:Concept ;
    rdfs:label "renúncia ao benefício de excussão prévia"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/garantias> ;
    fl:definition "Situação em que a instituição de crédito pode exigir diretamente ao fiador o pagamento dos valores em dívida, podendo executar os seus bens mesmo que ainda existam bens do devedor."@pt .

kg:representante-dos-participante-e-beneficiario a fl:Concept ;
    rdfs:label "representantes dos participantes e beneficiários"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Membros da comissão de acompanhamento do plano de pensões, que devem ser pelo menos um terço dos membros da comissão."@pt .

kg:resolucao a fl:Concept ;
    rdfs:label "resolução"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Cessação do contrato de seguro por iniciativa de uma das partes, podendo ocorrer com justa causa."@pt .

kg:resolucao-do-contrato a fl:Right ;
    rdfs:label "resolução do contrato"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Direito do tomador do seguro (pessoa singular) de fazer cessar o contrato celebrado por telefone ou Internet por resolução, sem necessidade de invocar motivo."@pt .

kg:responsabilidade-civil a fl:Concept ;
    rdfs:label "responsabilidade civil"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-habita%C3%A7%C3%A3o> ;
    fl:hasTopic fl:t-seguros .

kg:responsabilidade-da-entidade-gestora a fl:Concept ;
    rdfs:label "responsabilidade da entidade gestora"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "A responsabilidade pelo cumprimento das obrigações de informação e prestação de serviços é sempre da entidade gestora."@pt .

kg:responsabilidade-pelo-pagamento-de-credito a fl:Risk ;
    rdfs:label "responsabilidade pelo pagamento de créditos"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/contrair-credito> ;
    fl:definition "Situação em que uma pessoa pode ser obrigada a pagar créditos contraídos por terceiros, como familiares ou amigos."@pt .

kg:risco-de-incumprimento a fl:Risk ;
    rdfs:label "risco de incumprimento"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/contrair-credito> ;
    fl:definition "Risco de não conseguir pagar as prestações do crédito, levando à penhora do património do fiador."@pt .

kg:risco-de-movimentacao-nao-autorizada a fl:Risk ;
    rdfs:label "risco de movimentações não autorizadas"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/fazer-pagamentos> ;
    fl:definition "Risco associado aos meios de pagamento, que pode resultar na utilização indevida da conta de depósito à ordem."@pt ;
    fl:hasTopic fl:t-prevencao-fraude ;
    fl:relatedTo kg:meio-de-pagamento .

kg:risco-de-perda-de-capital a fl:Risk ;
    rdfs:label "risco de perda de capital"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/produtos-financeiros-complexos> ;
    fl:definition "Risco associado a produtos financeiros complexos, que podem gerar perdas superiores ao capital aplicado."@pt .

kg:risco-eletrico a fl:Risk ;
    rdfs:label "riscos elétricos"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-habita%C3%A7%C3%A3o> ;
    fl:hasTopic fl:t-seguros .

kg:seguro-de-acidente a fl:Product ;
    rdfs:label "seguro de acidentes"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Seguro que garante a prestação acordada no caso de verificação de lesão corporal, invalidez ou morte da pessoa segura resultante de um acidente."@pt ;
    fl:hasTopic fl:t-seguros ;
    fl:relatedTo kg:seguro-de-pessoa .

kg:seguro-de-responsabilidade-civil-facultativo a fl:Product ;
    rdfs:label "seguro de responsabilidade civil facultativo"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-responsabilidade-civil> ;
    fl:definition "Seguro cujas coberturas são acordadas entre o tomador e o segurador."@pt .

kg:seguro-de-responsabilidade-civil-obrigatorio a fl:Product ;
    rdfs:label "seguro de responsabilidade civil obrigatório"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-responsabilidade-civil> ;
    fl:definition "Seguro cujas coberturas mínimas estão definidas na lei ou regulamentação."@pt .

kg:seguro-de-vida-associado-ao-credito-a-habitacao a fl:Product ;
    rdfs:label "seguro de vida associado ao crédito à habitação"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Seguro de vida em que o tomador é simultaneamente beneficiário e deve informar os segurados sobre remunerações."@pt .

kg:seguro-exigido a fl:Cost ;
    rdfs:label "seguros exigidos"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0> ;
    fl:definition "Seguros que o consumidor deve contratar como parte das condições do empréstimo."@pt .

kg:seguro-obrigatorio-de-responsabilidade-civil-automovel a fl:Product ;
    rdfs:label "seguro obrigatório de responsabilidade civil automóvel"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/servi%C3%A7os/coloca%C3%A7%C3%A3o-de-seguro-autom%C3%B3vel> ;
    fl:definition "Seguro automóvel que é obrigatório, sendo recusado por três empresas de seguros, o que leva à colocação do contrato."@pt ;
    fl:hasTopic fl:t-seguros ;
    fl:relatedTo kg:colocacao-de-seguro-automovel .

kg:seguro-para-garantia-da-obrigacao-de-pagamento a fl:Product ;
    rdfs:label "seguro para garantia da obrigação de pagamento"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-reembolsar-e-transferir> ;
    fl:definition "Seguro celebrado para garantia da obrigação de pagamento no âmbito do contrato."@pt ;
    fl:hasTopic fl:t-seguros ;
    fl:relatedTo kg:credito-a-habitacao .

kg:servico-de-homebanking a fl:Product ;
    rdfs:label "serviços de homebanking"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:hasTopic fl:t-contas-bancarias .

kg:simulador-do-orcamento-familiar a fl:Product ;
    rdfs:label "simulador do orçamento familiar"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/simuladororcamentofamiliar> ;
    fl:definition "Ferramenta de apoio à elaboração do orçamento familiar, que permite calcular a diferença entre rendimentos e despesas e avaliar o peso dos encargos financeiros no total dos rendimentos."@pt ;
    fl:hasTopic fl:t-despesas-rendimentos,
        fl:t-necessidades-desejos .

kg:sindicato-mal-representativo a fl:Concept ;
    rdfs:label "sindicatos mais representativos"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Sindicatos que, no setor de atividade, têm maior representatividade e podem ter representantes na comissão de acompanhamento do plano de pensões."@pt .

kg:solucao-de-regularizacao a fl:Concept ;
    rdfs:label "solução de regularização"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/gestao-do-incumprimento> ;
    fl:definition "Proposta alternativa para resolver uma situação de incumprimento, que pode incluir novas condições de pagamento."@pt .

kg:tan a fl:Concept ;
    rdfs:label "TAN"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0> ;
    fl:definition "Taxa Anual Nominal aplicável ao crédito, com identificação das suas componentes (indexante e spread)."@pt .

kg:taxa-anual-nominal-liquida-tanl a fl:Concept ;
    rdfs:label "taxa anual nominal líquida (TANL)"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro> ;
    fl:definition "Taxa anual que incorpora a retenção de impostos e corresponde aos juros que o cliente recebe."@pt .

kg:taxa-de-inflacao a fl:Concept ;
    rdfs:label "taxa de inflação"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/depositos-prazo> ;
    fl:definition "Aumento geral dos preços dos bens e serviços, que deve ser comparado com a taxa de juro do depósito para avaliar a remuneração real."@pt .

kg:taxa-de-juro-aplicada-a-facilidade-de-descoberto a fl:Concept ;
    rdfs:label "taxa de juro aplicada à facilidade de descoberto"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/extratos-e-saldos> ;
    fl:definition "Taxa cobrada pela instituição de crédito pela utilização da facilidade de descoberto."@pt .

kg:taxa-de-juro-de-mora a fl:Concept ;
    rdfs:label "taxa de juro de mora"@pt ;
    skos:altLabel "taxa de juros de mora"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar>,
        <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0> ;
    fl:definition "Taxa aplicada em caso de atraso no pagamento do empréstimo, que pode aumentar o custo total do empréstimo."@pt,
        "Taxa de juros de mora aplicável em caso de falta de pagamento, que deve constar do contrato de crédito."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:taxa-de-juro-fixa-ou-variavel a fl:Concept ;
    rdfs:label "taxa de juro fixa ou variável"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/gestao-do-incumprimento> ;
    fl:definition "Taxa de juro que pode ser fixa (não varia) ou variável (depende de um índice de referência)."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:refinanciamento-da-divida .

kg:taxa-de-juro-media-ponderada a fl:Concept ;
    rdfs:label "taxa de juro média ponderada"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/gestao-do-incumprimento> ;
    fl:definition "Média das taxas de juro dos contratos consolidados, ponderada pelo montante em dívida de cada um."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:consolidacao-de-credito .

kg:taxa-de-juro-nominal a fl:Concept ;
    rdfs:label "taxa de juro nominal"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro> ;
    fl:definition "Taxa de juro que não considera a inflação e é usada para calcular os juros recebidos em depósitos."@pt ;
    fl:relatedTo kg:inflacao,
        kg:taxa-de-juro-real .

kg:taxa-de-juro-real a fl:Concept ;
    rdfs:label "taxa de juro real"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro> ;
    fl:definition "Taxa de juro nominal corrigida pela inflação, que indica se a poupança está a ganhar valor ao longo do tempo."@pt .

kg:taxa-de-juro-remuneratoria a fl:Concept ;
    rdfs:label "taxa de juro remuneratória"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/extratos-e-saldos> ;
    fl:definition "Taxa aplicada à conta de depósito à ordem, que remunera o saldo disponível."@pt .

kg:taxa-de-retencao-na-fonte a fl:Cost ;
    rdfs:label "taxa de retenção na fonte"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro> ;
    fl:definition "Percentagem dedutível do valor dos juros, no caso de 28%, que é retida antes de ser creditada na conta."@pt .

kg:taxa-euribor a fl:Concept ;
    rdfs:label "taxa Euribor"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/depositos-prazo> ;
    fl:definition "Taxa de referência usada para calcular a remuneração de depósitos a prazo a taxa variável."@pt .

kg:taxa-maxima-no-credito-aos-consumidor a fl:Concept ;
    rdfs:label "taxas máximas no crédito aos consumidores"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro-no-credito-aos-consumidores> ;
    fl:definition "Limites aos encargos que podem ser praticados no crédito aos consumidores."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:taxa-de-juro-anual-nominal-tan .

kg:taxa-nominal-anual-bruta-tanb a fl:Concept ;
    rdfs:label "taxa nominal anual bruta (TANB)"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro> ;
    fl:definition "Taxa usada para comparar depósitos a prazo com juros simples."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca,
        fl:t-custos-credito .

kg:tempestade a fl:Risk ;
    rdfs:label "tempestades"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-habita%C3%A7%C3%A3o> ;
    fl:hasTopic fl:t-seguros .

kg:titular-de-conta a fl:Concept ;
    rdfs:label "titular de conta"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/titularidade-e-movimentacao> ;
    fl:definition "Pessoa a quem pertencem os fundos depositados e responsável pela sua movimentação."@pt .

kg:transferencia a fl:Concept ;
    rdfs:label "transferência"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/fazer-pagamentos> ;
    fl:definition "Meio de pagamento que permite transferir dinheiro entre contas bancárias."@pt ;
    fl:hasTopic fl:t-meios-pagamento ;
    fl:relatedTo kg:meio-de-pagamento .

kg:transferencia-a-credito a fl:Concept ;
    rdfs:label "transferência a crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/mudanca-de-conta> ;
    fl:definition "Operação em que um beneficiário recebe fundos diretamente de uma conta."@pt .

kg:transferencia-do-emprestimo a fl:Concept ;
    rdfs:label "transferência do empréstimo"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-reembolsar-e-transferir> ;
    fl:definition "Processo de transferir um empréstimo de uma instituição para outra, que exige reembolso antecipado total."@pt ;
    fl:hasTopic fl:t-emprestimos ;
    fl:relatedTo kg:reembolso-antecipado .

kg:transferencia-multibanco a fl:Product ;
    rdfs:label "transferência Multibanco"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/transferencias> ;
    fl:definition "Transferência efetuada num caixa automático Multibanco através de um cartão de pagamento."@pt ;
    fl:hasTopic fl:t-meios-pagamento ;
    fl:relatedTo kg:homebanking .

kg:utilizacao-dos-fundo-para-a-finalidade-acordada a fl:Right ;
    rdfs:label "utilização dos fundos para a finalidade acordada"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/direitos-e-deveres-na-contratacao-de-credito> ;
    fl:definition "O cliente deve utilizar os fundos para a finalidade acordada no contrato."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito ;
    fl:relatedTo kg:dever-de-cumprimento-do-contrato .

kg:videoconferencia a fl:Concept ;
    rdfs:label "videoconferência"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Método de comprovação de elementos de identificação por meio de ligação em tempo real entre a instituição de crédito e o cliente."@pt .

kg:acao-judicial-para-recuperacao-do-credito a fl:Concept ;
    rdfs:label "ação judicial para recuperação do crédito"@pt ;
