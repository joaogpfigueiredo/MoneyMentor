kg:rendimento-regular a fl:Concept ;
    rdfs:label "rendimento regular"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/avaliacao-da-solvabilidade> ;
    fl:definition "Rendimentos recebidos pelo cliente bancário com caráter regular, utilizados na avaliação da solvabilidade."@pt ;
    fl:hasTopic fl:t-necessidades-capacidades .

kg:renegociacao-de-contrato-de-credito a fl:Concept ;
    rdfs:label "renegociação de contrato de crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/responsabilidades-de-credito> ;
    fl:definition "Processo de renegociação de um contrato anterior, realizado com o objetivo de prevenir ou regularizar uma situação de incumprimento, classificado como renegociação por prevenção ou por incumprimento."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:reparacao-por-acidente-de-trabalho a fl:Right ;
    rdfs:label "reparação por acidente de trabalho"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Direito do trabalhador à obtenção de prestações em caso de acidente de trabalho, compreendendo dois grupos de prestações."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:resolucao-de-litigio a fl:Right ;
    rdfs:label "resolução de litígios"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/servi%C3%A7os/reclama%C3%A7%C3%B5es/meios-de-resolu%C3%A7%C3%A3o-de-lit%C3%ADgios> ;
    fl:definition "Processo legal ou alternativo para resolver conflitos entre consumidores e operadores, mediante tribunal ou instância de resolução alternativa de litígios."@pt ;
    fl:relatedTo kg:arbitragem,
        kg:centro-de-arbitragem-de-conflito-de-consumo,
        kg:cimpa .

kg:resolucao-do-contrato-de-credito a fl:Right ;
    rdfs:label "resolução do contrato de crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-tipos-de-credito> ;
    fl:definition "Direito de resolver o contrato de crédito."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:responsabilidade-da-empresa-de-seguro a fl:Concept ;
    rdfs:label "responsabilidade da empresa de seguros"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Responsabilidade da empresa de seguros em designar um médico assistente e em gerir a indemnização do sinistro."@pt ;
    fl:hasTopic fl:t-seguros .

kg:retribuicao-minima-mensal-garantida-rmmg a fl:Concept ;
    rdfs:label "retribuição mínima mensal garantida (RMMG)"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Valor mínimo garantido mensalmente, utilizado para definir condições de recebimento de benefícios em capital."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:revogacao-do-credito a fl:Right ;
    rdfs:label "revogação do crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar> ;
    fl:definition "Direito do cliente de revogar o crédito no prazo de 14 dias, conforme fixado nas fichas de informação normalizada."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:risco-de-capital a fl:Risk ;
    rdfs:label "risco de capital"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/produtos-financeiros-complexos>,
        <https://www.todoscontam.pt/pt-pt/riscos-dos-produtos> ;
    fl:definition "Risco associado à possibilidade de perder parte ou a totalidade do capital investido, com exceções como obrigações estruturadas que podem garantir o capital na maturidade."@pt,
        "Risco de perda parcial ou total do capital investido na aplicação financeira."@pt .

kg:risco-de-inadimplencia a fl:Risk ;
    rdfs:label "risco de inadimplência"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Risco de que o contrato cesse automaticamente se o prémio não for pago na data devida."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:risco-de-incendio a fl:Risk ;
    rdfs:label "risco de incêndio"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-habita%C3%A7%C3%A3o> ;
    fl:definition "Risco coberto pelo seguro de habitação, com valor do capital seguro baseado no custo de reconstrução do imóvel."@pt ;
    fl:hasTopic fl:t-seguros .

kg:risco-de-inflacao a fl:Risk ;
    rdfs:label "risco de inflação"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/riscos-dos-produtos> ;
    fl:definition "Risco de redução do valor real ou do poder de compra dos fundos investidos numa aplicação financeira devido à subida dos preços."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:risco-de-taxa-de-juro a fl:Risk ;
    rdfs:label "risco de taxa de juro"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro-no-credito-habitacao> ;
    fl:definition "Risco de variação da taxa de juro que pode afectar o valor das prestações do empréstimo."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:sacado a fl:Concept ;
    rdfs:label "sacado"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/cheques> ;
    fl:definition "Instituição de crédito emissora do cheque."@pt ;
    fl:hasTopic fl:t-meios-pagamento .

kg:sacador a fl:Concept ;
    rdfs:label "sacador"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/cheques> ;
    fl:definition "Pessoa que passa o cheque."@pt ;
    fl:hasTopic fl:t-meios-pagamento .

kg:saldo a fl:Concept ;
    rdfs:label "saldo"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/identificar-rendimentos-e-despesas> ;
    fl:definition "Resultado da subtração das despesas aos rendimentos, que indica a situação financeira do agregado familiar."@pt ;
    fl:hasTopic fl:t-despesas-rendimentos ;
    fl:relatedTo kg:despesa,
        kg:rendimento .

kg:seguranca-de-credito-para-deficiente-das-forca-armada a fl:Right ;
    rdfs:label "segurança de crédito para deficientes das forças armadas"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Direito de celebrar contratos para a aquisição ou construção de habitação própria nas mesmas condições estabelecidas para os trabalhadores de instituições de crédito."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:seguro-associado-ao-credito-a-habitacao a fl:Product ;
    rdfs:label "seguro associado ao crédito à habitação"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/direito-ao-esquecimento> ;
    fl:definition "Seguro vinculado a um crédito à habitação, que pode ser reclamado diretamente à empresa de seguros ou à ASF."@pt ;
