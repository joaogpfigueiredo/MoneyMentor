    fl:definition "Conta que pode ser aberta no estrangeiro, sujeita às regras do país onde a instituição está sediada."@pt ;
    fl:hasCost kg:comissao-de-manutencao ;
    fl:hasTopic fl:t-contas-bancarias ;
    fl:relatedTo kg:regra-de-identificacao,
