    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro> ;
    fl:definition "Taxa que inclui o efeito da capitalização dos juros, usada para comparar depósitos a prazo com juros compostos."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca,
        fl:t-custos-credito .

kg:taxa-anual-nominal-bruta a fl:Concept ;
    rdfs:label "taxa anual nominal bruta"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/simples>,
        <https://www.todoscontam.pt/pt-pt/obrigacoes> ;
    fl:definition "Taxa anual nominal bruta (TANB) é uma taxa de juro aplicável ao depósito, antes de deduzir impostos ou outros encargos."@pt,
        "Taxa de juro oferecida pelo investimento em obrigações, que é indicada em regra para a avaliação do investimento."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:taxa-anual-nominal-bruta-tanb a fl:Concept ;
    rdfs:label "taxa anual nominal bruta (TANB)"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro>,
        <https://www.todoscontam.pt/pt-pt/depositos-prazo> ;
    fl:definition "Taxa anual que expressa a remuneração do depósito para o período de um ano, sem considerar impostos ou inflação."@pt,
        "Taxa usada para comparar remunerações de depósitos a prazo, considerando a remuneração média ao longo do prazo."@pt ;
    fl:relatedTo kg:taxa-anual-nominal-liquida-tanl .

kg:teste-de-adequacao a fl:Concept ;
