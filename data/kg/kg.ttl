    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura>,
        <https://clientebancario.bportugal.pt/pt-pt/direitos-e-deveres-na-contratacao-de-depositos> ;
    fl:definition "Custos associados ao uso de um descoberto bancário."@pt,
        "Custos associados aos serviços de pagamento e à utilização da conta."@pt .

kg:comparticipacao a fl:Concept ;
    rdfs:label "comparticipação"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Parte das despesas de saúde coberta por um sistema de segurança social, que o seguro não cobre."@pt,
        "Percentagens máximas pagas pela empresa de seguros, que o segurado deve suportar."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-seguros .

kg:conta-de-deposito a fl:Product ;
    rdfs:label "conta de depósito"@pt ;
    skos:altLabel "conta de depósito à ordem"@pt ;
