    fl:hasTopic fl:t-emprestimos .

kg:prazo-maximo-para-entrega-do-pedido-de-pagamento a fl:Concept ;
    rdfs:label "prazo máximo para entrega do pedido de pagamento"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Prazo máximo para entrega do pedido de pagamento das despesas, contado a partir da data em que foram realizadas."@pt ;
    fl:hasTopic fl:t-seguros .

kg:prazo-maximo-para-reembolsar-a-pessoa-segura a fl:Concept ;
    rdfs:label "prazo máximo para reembolsar a pessoa segura"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Prazo máximo para reembolsar a pessoa segura após a realização de despesas."@pt ;
    fl:hasTopic fl:t-seguros .

kg:prestacao-em-dinheiro a fl:Concept ;
    rdfs:label "prestações em dinheiro"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Indemnizações em dinheiro por incapacidade temporária ou permanente, pensões, subsídios e outras compensações financeiras previstas no seguro."@pt ;
    fl:hasTopic fl:t-seguros .

kg:prestacao-em-especie a fl:Concept ;
    rdfs:label "prestações em espécie"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Coberturas que incluem assistência médica, hospitalização, tratamentos termais, reabilitação, apoio psicológico e outros serviços necessários ao sinistrado."@pt ;
    fl:hasTopic fl:t-seguros .

kg:produto-ou-servico-financeiro a fl:Concept ;
    rdfs:label "produto ou serviço financeiro"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0> ;
    fl:definition "Produto ou serviço que pode ser adquirido em conjunto com o crédito e influenciar o valor da prestação."@pt ;
    fl:relatedTo kg:spread .

kg:proponente a fl:Concept ;
    rdfs:label "proponente"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Pessoa que pretende aderir a um seguro de grupo e envia a proposta de adesão ao tomador do seguro."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:quadro-da-amortizacao a fl:Concept ;
    rdfs:label "quadro da amortização"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar> ;
    fl:definition "Quadro que indica as prestações devidas, decompostas em amortização de capital, juros e outros encargos, bem como as datas de pagamento."@pt ;
    fl:hasTopic fl:t-planeamento .

kg:quota-parte a fl:Concept ;
    rdfs:label "quota-parte"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/titularidade-e-movimentacao> ;
    fl:definition "Parte do saldo de uma conta coletiva correspondente ao titular falecido, a ser cativada pela instituição de crédito."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:reembolso-antecipado-total a fl:Right ;
    rdfs:label "reembolso antecipado total"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-renegociar-ou-reembolsar-antecipadamente> ;
    fl:definition "Direito dos clientes bancários a reembolso antecipado total, com direito a um documento gratuito para extinção da garantia real associada ao empréstimo."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:remuneracao a fl:Concept ;
    rdfs:label "remuneração"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura>,
        <https://clientebancario.bportugal.pt/pt-pt/o-que-sao-e-tipos-de-depositos> ;
    fl:definition "Valor pago pela instituição ao cliente por ter depositado os fundos."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:remuneracao-da-entidade-gestora a fl:Concept ;
    rdfs:label "remuneração da entidade gestora"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Percentagem que determina o valor das unidades de participação nos fundos de pensões abertos."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca .

kg:risco-de-reinvestimento a fl:Risk ;
    rdfs:label "risco de reinvestimento"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/riscos-dos-produtos> ;
    fl:definition "Risco dos rendimentos recebidos durante a vida de uma aplicação não serem investidos à taxa de remuneração dessa aplicação."@pt ;
    fl:relatedTo kg:deposito-a-prazo .

kg:saldo-da-conta-de-origem a fl:Cost ;
    rdfs:label "saldo da conta de origem"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/mudanca-de-conta> ;
    fl:definition "Dinheiro disponível na conta de origem que deve ser suficiente para cobrir os pagamentos realizados durante a mudança de conta."@pt ;
    fl:hasTopic fl:t-contas-bancarias .

kg:seguranca-social a fl:Concept ;
    rdfs:label "segurança social"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Referido como fonte de rendimentos para clientes que estão dispensados da entrega de declaração de rendimentos ao abrigo do Código do IRS."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:seguro-de-cobertura-de-risco a fl:Product ;
    rdfs:label "seguro de cobertura de risco"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/encerramento-de-conta> ;
    fl:definition "Seguro associado à conta que não impede o encerramento, desde que seja indicada outra conta para associar os contratos."@pt ;
    fl:relatedTo kg:encerramento-de-conta .

kg:taxa-anual-nominal-tan a fl:Concept ;
    rdfs:label "taxa anual nominal (tan)"@pt ;
    skos:altLabel "taxa anual nominal (TAN)"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0> ;
    fl:definition "Taxa de juro anual que o banco cobre ao cliente, incluindo as suas componentes e forma de cálculo."@pt,
        "Taxa que representa o custo do empréstimo em termos nominais, incluindo a taxa fixa, indexante e spread."@pt .

kg:taxa-de-juro-bonificada a fl:Concept ;
    rdfs:label "taxa de juro bonificada"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Bonificação na taxa de juro igual à diferença entre a taxa de referência para bonificações (TRCB) e 65% da taxa de referência do Banco Central Europeu."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:taxa-de-juro-simple a fl:Concept ;
    rdfs:label "taxa de juro simples"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro> ;
    fl:definition "Taxa de juro que considera que o capital aplicado se mantém constante ao longo do tempo e os juros são pagos apenas sobre o capital inicial."@pt ;
    fl:relatedTo kg:taxa-de-juro-composto .

kg:taxa-variavel a fl:Concept ;
    rdfs:label "taxa variável"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/simples> ;
    fl:definition "Taxa de juro que varia conforme um indexante, com indicação da frequência de revisão e do spread aplicável."@pt,
        "Taxa de remuneração do depósito que depende da evolução de um indexante de mercado monetário, como a Euribor."@pt .

kg:terceiro-lesado a fl:Concept ;
    rdfs:label "terceiro lesado"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/fazer-um-seguro-0> ;
    fl:definition "Pessoa ou entidade que tenha sofrido prejuízos que o segurado deva indemnizar."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:transferencia-bancaria a fl:Concept ;
    rdfs:label "transferência bancária"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/transferencias> ;
    fl:definition "Movimentação do numerário de uma conta bancária para outra, quando o cliente ordena à instituição a disponibilização de uma quantia à ordem de um beneficiário."@pt ;
    fl:hasTopic fl:t-meios-pagamento .

kg:valor-liquido-global a fl:Concept ;
    rdfs:label "valor líquido global"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Valor total do património do fundo de pensões, após deduzir despesas e outros encargos."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca .

kg:venda-associada-obrigatoria a fl:Concept ;
    rdfs:label "vendas associadas obrigatórias"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0> ;
    fl:definition "Prática proibida em Portugal, que consiste em exigir a contratação de outros produtos ou serviços como condição para conceder um crédito."@pt ;
    fl:relatedTo kg:venda-associada-facultativa .

kg:acordo-para-a-regularizacao-da-situacao-de-incumprimento a fl:Concept ;
    rdfs:label "acordo para a regularização da situação de incumprimento"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/gestao-do-incumprimento> ;
    fl:definition "Acordo entre o cliente e a instituição para resolver uma situação de incumprimento, levando à extinção do PERSI."@pt .

kg:adesao-individual a fl:Concept ;
    rdfs:label "adesão individual"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/descodificador> ;
    fl:definition "Forma de adesão a um seguro em que o consumidor é o único beneficiário e responsável pelas coberturas."@pt ;
    fl:hasTopic fl:t-seguros ;
    fl:relatedTo kg:seguro-de-saude .

kg:adiantamento-de-numerario-a-credito a fl:Concept ;
    rdfs:label "adiantamento de numerário a crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e> ;
    fl:definition "Operação de levantar dinheiro a crédito através do cartão de crédito."@pt .

kg:alteracao-ao-plano-de-pensao a fl:Concept ;
    rdfs:label "alterações ao plano de pensões"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Modificações que podem afetar comissões, políticas de investimento, garantias de capital ou transferências de gestão, exigindo notificação aos participantes."@pt .

kg:alteracao-de-taxa-de-juro a fl:Concept ;
    rdfs:label "alterações de taxa de juro"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0> ;
    fl:definition "Alterações previstas contratualmente na taxa de juro dos contratos de crédito à habitação e outros contratos hipotecários, que devem ser informadas com antecedência mínima de 15 dias."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:credito-a-habitacao .

kg:anuidade-do-cartao a fl:Cost ;
    rdfs:label "anuidade do cartão"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e> ;
    fl:definition "Custo anual associado ao uso do cartão de crédito."@pt .

kg:arbitragem a fl:Right ;
    rdfs:label "arbitragem"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/servi%C3%A7os/reclama%C3%A7%C3%B5es/meios-de-resolu%C3%A7%C3%A3o-de-lit%C3%ADgios> ;
    fl:definition "Método alternativo de resolução de litígios, que pode ser obrigatório ou voluntário, dependendo do tipo de conflito."@pt .

kg:associado a fl:Concept ;
    rdfs:label "associado"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Entidade que atua como empregador e estabelece um plano de pensões ou de benefícios de saúde."@pt .

kg:ato-suscetivel-de-por-em-causa-os-direito-ou-as-garantia-da-instituicao a fl:Concept ;
    rdfs:label "atos suscetíveis de pôr em causa os direitos ou as garantias da instituição"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/gestao-do-incumprimento> ;
    fl:definition "Ações do cliente que podem comprometer os direitos ou garantias da instituição, podendo levar à extinção do PERSI."@pt .

kg:beneficio-de-excussao-previa a fl:Concept ;
    rdfs:label "benefício de excussão prévia"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/garantias> ;
    fl:definition "Direito do fiador de recusar-se a pagar os valores em incumprimento enquanto a instituição não esgotar todas as possibilidades de cobrança junto do devedor principal."@pt .

kg:bloqueio-de-conta a fl:Concept ;
    rdfs:label "bloqueio de conta"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/titularidade-e-movimentacao> ;
    fl:definition "Bloqueio da conta em situações excecionais para apurar o saldo à data do óbito, com prazo máximo de um dia útil."@pt .

kg:caducidade a fl:Concept ;
    rdfs:label "caducidade"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Situação em que o contrato de seguro termina por não cumprimento das condições estabelecidas."@pt .

kg:capital-aplicado a fl:Concept ;
    rdfs:label "capital aplicado"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/produtos-financeiros-complexos> ;
    fl:definition "Valor investido em produtos financeiros complexos, que pode ser perdido."@pt .

kg:cartao-de-cidadao a fl:Product ;
    rdfs:label "cartão de cidadão"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Documento de identificação utilizado para comprovação de elementos de identificação de pessoas singulares."@pt .

kg:centro-de-arbitragem-de-conflito-de-consumo a fl:Right ;
    rdfs:label "centro de arbitragem de conflitos de consumo"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/servi%C3%A7os/reclama%C3%A7%C3%B5es/meios-de-resolu%C3%A7%C3%A3o-de-lit%C3%ADgios> ;
    fl:definition "Instituição que resolve litígios de consumo de forma rápida, simples e económica, especialmente quando o valor não excede 5 000,00 €."@pt .

kg:certificado-de-aforro a fl:Product ;
    rdfs:label "certificado de aforro"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/poupar-e-investir> ;
    fl:definition "Produto de poupança que representa dívida pública emitida pelo Estado Português, adquirido através de CTT ou AforroNet."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca,
        fl:t-objetivos-poupanca .

kg:certificado-do-tesouro a fl:Product ;
    rdfs:label "certificado do tesouro"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/poupar-e-investir> ;
    fl:definition "Produto de poupança que representa dívida pública emitida pelo Estado Português, adquirido através de CTT ou AforroNet."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca,
        fl:t-objetivos-poupanca .

kg:chave-movel-digital a fl:Product ;
    rdfs:label "chave móvel digital"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Ferramenta utilizada para comprovação de elementos de identificação de pessoas singulares."@pt .

kg:cobertura-de-seguro a fl:Concept ;
    rdfs:label "cobertura de seguro"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-responsabilidade-civil> ;
    fl:definition "Conjunto de riscos que o seguro pode assumir, como atividades, profissões ou situações da vida familiar."@pt .

kg:cobertura-de-seguro-de-saude a fl:Concept ;
    rdfs:label "cobertura de seguro de saúde"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Cobertura de riscos relacionados com a prestação de cuidados de saúde, conforme as condições do contrato."@pt .

kg:comissao-de-cash-advance a fl:Cost ;
    rdfs:label "comissão de cash-advance"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e> ;
    fl:definition "Custo relacionado com o levantamento de dinheiro a crédito, incluindo um valor fixo e uma percentagem sobre o montante levantado."@pt .

kg:comissao-de-cobranca a fl:Cost ;
    rdfs:label "comissão de cobrança"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/titularidade-e-movimentacao> ;
    fl:definition "Cobrança de comissões que não podem exceder 10% do indexante de apoios sociais (IAS), ou seja, 53,71 euros."@pt .

kg:comissao-de-deposito-de-moeda a fl:Cost ;
    rdfs:label "comissão de depósito de moedas"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/encargos> ;
    fl:definition "Comissão pelo depósito de moedas, que não pode exceder 2% do valor depositado."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:precario .

kg:comissao-de-emissao a fl:Cost ;
    rdfs:label "comissão de emissão"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Valor cobrado pela entidade gestora ao participante, que pode ser deduzido na devolução do valor."@pt .

kg:comissao-de-emissao-de-extrato a fl:Cost ;
    rdfs:label "comissão de emissão de extrato"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/extratos-e-saldos> ;
    fl:definition "Cobrança por parte das instituições de crédito pela emissão de segunda via de extratos bancários, que não pode ser cobrada."@pt .

kg:comissao-de-envio-de-fundo-para-conta-de-moeda-eletronica a fl:Cost ;
    rdfs:label "comissão de envio de fundos para contas de moeda eletrónica"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/encargos> ;
    fl:definition "Comissão pelo envio de fundos para contas de moeda eletrónica, que não pode exceder o valor das comissões devidas por transferências cobradas pela instituição."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:precario .

kg:comissao-de-habilitacao-de-herdeiro a fl:Cost ;
    rdfs:label "comissão de habilitação de herdeiros"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/encargos> ;
    fl:definition "Comissão no âmbito de habilitação de herdeiros por óbito de um titular de conta de depósito à ordem, que não pode exceder 10% do IAS, ou seja, 53,71 euros."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:precario .

kg:comissao-de-manutencao-de-conta a fl:Cost ;
    rdfs:label "comissão de manutenção de conta"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/encargos> ;
    fl:definition "Cobrada pela titularidade da conta, mesmo quando não há movimentos ou saldo."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:servico-minimo-bancario .

kg:comissao-de-mudanca-de-conta a fl:Cost ;
    rdfs:label "comissão de mudança de conta"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/mudanca-de-conta> ;
    fl:definition "Custos cobrados pelos prestadores de serviços de pagamento por tarefas associadas ao processo de mudança de conta."@pt ;
    fl:relatedTo kg:prestador-de-destino,
        kg:prestador-de-origem .

kg:comissao-de-recuperacao-de-divida a fl:Cost ;
    rdfs:label "comissão de recuperação de dívida"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/atraso-no-pagamento> ;
    fl:definition "Cobrada uma vez por cada prestação vencida e não paga, não pode exceder 4% do valor da prestação, com mínimo de 12 euros e máximo de 150 euros."@pt ;
    fl:hasTopic fl:t-custos-credito ;
    fl:relatedTo kg:incumprimento .

kg:comissao-de-trabalhador-do-associado a fl:Concept ;
    rdfs:label "comissão de trabalhadores do associado"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Representante dos trabalhadores no associado, que faz parte da comissão de acompanhamento do plano de pensões."@pt .

kg:comissao-de-transacao a fl:Cost ;
    rdfs:label "comissão de transação"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/acoes> ;
    fl:definition "Custo envolvido na transação e detenção de ações."@pt .

kg:comissao-de-utilizacao-no-estrangeiro a fl:Cost ;
    rdfs:label "comissão de utilização no estrangeiro"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e> ;
    fl:definition "Custo associado à utilização do cartão de crédito no estrangeiro."@pt .

kg:comunicacao-de-dificuldade-em-pagar a fl:Right ;
    rdfs:label "comunicação de dificuldades em pagar"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/direitos-e-deveres-na-contratacao-de-credito> ;
    fl:definition "O cliente deve comunicar à instituição de crédito eventuais dificuldades em pagar os empréstimos contratados."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito ;
    fl:relatedTo kg:dever-de-cumprimento-do-contrato .

kg:conta-coletiva-conjunta a fl:Product ;
    rdfs:label "conta coletiva conjunta"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/titularidade-e-movimentacao> ;
    fl:definition "Conta coletiva que só pode ser movimentada mediante as assinaturas de todos os seus titulares."@pt .

kg:conta-coletiva-mista a fl:Product ;
