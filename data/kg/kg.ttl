kg:premio-de-seguro a fl:Cost ;
    rdfs:label "prémio de seguro"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro>,
        <https://www.consumidor.asf.com.pt/direito-ao-esquecimento>,
        <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es>,
        <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro>,
        <https://www.consumidor.asf.com.pt/seguros/seguro-de-habita%C3%A7%C3%A3o>,
        <https://www.todoscontam.pt/pt-pt/fazer-um-seguro-0>,
        <https://www.todoscontam.pt/pt-pt/seguro>,
        <https://www.todoscontam.pt/pt-pt/seguros-1>,
        <https://www.todoscontam.pt/pt-pt/tipos-de-seguro-0> ;
    fl:definition "Custo do seguro, que a pessoa ou entidade que celebra o seguro fica obrigada a pagar à seguradora."@pt,
        "Preço do seguro, que inclui custos da cobertura, gestão do contrato e emissão da apólice."@pt,
        "Preço do seguro, que inclui os custos da cobertura do risco, os custos de aquisição e gestão do contrato e de cobrança e os encargos relacionados com a emissão da apólice."@pt,
        "Valor a pagar pelo seguro, calculado com base nas informações fornecidas na proposta de seguro."@pt,
        "Valor pago pelo segurado ao segurador para contratar o seguro, que é calculado em função das coberturas contratadas."@pt,
        "Valor pago pelo seguro que garante o pagamento da pensão, mencionado em relação a três seguradores."@pt,
        "Valor pago pelo seguro, calculado em função das coberturas contratadas."@pt,
        "Valor pago pelo seguro, incluído na apólice de seguro."@pt,
        "Valor pago pelo seguro, influenciado por fatores como características do imóvel, coberturas e opções de franquias."@pt,
        "Valor pago pelo seguro, ou seja, o custo do seguro."@pt,
        "Valor pago pelo seguro, que deve ser mencionado na proposta e que o segurador deve esclarecer sobre a sua relação com as coberturas."@pt,
        "Valor pago pelo seguro, que não pode ser aumentado ou garantias excluídas devido a uma situação de risco agravado de saúde ou deficiência superada."@pt,
        "Valor pago pelo seguro, que não pode ser calculado com base em informação de saúde relativa a uma situação superada ou mitigada."@pt,
        "Valor pago pelo seguro, que não pode ser calculado com base em informações médicas que tenham sido superadas ou mitigadas."@pt,
        "Valor pago pelo seguro, que pode ser ajustado com base na correta ou incorreta comunicação do risco."@pt,
        "Valor pago pelo seguro, que pode ser alterado se a doença tenha contribuído para a sua fixação."@pt,
        "Valor pago pelo seguro, que pode ser aumentado ou excluído devido a uma situação de risco agravado de saúde ou deficiência."@pt,
        "Valor pago pelo seguro, que pode ser cobrado pelo segurador, e que pode ser afetado pela cessação do contrato."@pt,
        "Valor pago pelo seguro, que pode ser influenciado por situações de fraude."@pt,
        "Valor pago pelo seguro, que pode ser suportado parcialmente ou totalmente pelos segurados ou pelo tomador do seguro."@pt,
        "Valor pago pelo seguro, suportado parcial ou totalmente pelos segurados (seguro contributivo) ou totalmente pelo tomador (seguro não contributivo)."@pt,
        "Valor pago pelo tomador do seguro em troca da cobertura oferecida."@pt ;
