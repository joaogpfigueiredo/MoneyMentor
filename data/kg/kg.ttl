    fl:definition "Processo de antecipar necessidades futuras, especialmente relacionadas ao período da reforma, e sensibilizar para a importância de planejar de longo prazo."@pt,
        "Processo de gerir o orçamento de forma consciente e responsável, com vista a criar oportunidades e alcançar objetivos futuros."@pt ;
    fl:hasTopic fl:t-planeamento .

kg:ppr a fl:Product ;
