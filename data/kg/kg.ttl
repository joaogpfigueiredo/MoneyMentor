kg:rendimento-mensal a fl:Concept ;
    rdfs:label "rendimento mensal"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/elaborar-o-orcamento> ;
    fl:definition "Quantia recebida mensalmente pelo agregado familiar, que serve de base para a elaboração do orçamento."@pt ;
