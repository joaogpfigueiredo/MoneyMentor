    fl:definition "A ASF disponibiliza um serviço de atendimento direto, nos dias úteis, entre as 09h00 e as 16h00."@pt,
        "Serviço de atendimento disponibilizado pela ASF, nos dias úteis, entre as 09h00 e as 16h00."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:cartao-de-pagamento a fl:Product ;
    rdfs:label "cartão de pagamento"@pt ;
