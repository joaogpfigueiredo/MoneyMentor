    fl:relatedTo kg:credito-a-habitacao .

kg:denuncia a fl:Concept ;
    rdfs:label "denúncia"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Ato de terminar o contrato de seguro por vontade das partes."@pt,
        "Modo de cessar o contrato de seguro para evitar a sua prorrogação, a ser feita por escrito e com antecedência mínima de 30 ou 90 dias, conforme o tipo de seguro."@pt .

kg:desistir-de-produto-ou-servico a fl:Right ;
    rdfs:label "desistir de produtos ou serviços"@pt ;
