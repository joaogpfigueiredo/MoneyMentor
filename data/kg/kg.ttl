    fl:relatedTo kg:direito-de-resolucao-do-contrato,
        kg:reclamacao .

kg:seguro-associado-ao-credito-aos-consumidor a fl:Product ;
    rdfs:label "seguro associado ao crédito aos consumidores"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/direito-ao-esquecimento> ;
    fl:definition "Seguro vinculado a um crédito aos consumidores, que pode ser reclamado diretamente à empresa de seguros ou à ASF."@pt ;
    fl:regulatedBy fl:ASF ;
    fl:relatedTo kg:direito-de-resolucao-do-contrato,
        kg:reclamacao .

kg:seguro-associado-ao-credito-para-fin-comercial-ou-profissional a fl:Product ;
    rdfs:label "seguro associado ao crédito para fins comerciais ou profissionais"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/direito-ao-esquecimento> ;
    fl:definition "Seguro vinculado a um crédito para fins comerciais ou profissionais, que pode ser reclamado diretamente à empresa de seguros ou à ASF."@pt ;
    fl:regulatedBy fl:ASF ;
    fl:relatedTo kg:direito-de-resolucao-do-contrato,
        kg:reclamacao .

kg:seguro-contratado-a-distancia a fl:Product ;
    rdfs:label "seguro contratado à distância"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Seguro adquirido por telefone ou Internet, com prazos específicos para resolução e reembolso."@pt ;
    fl:hasCost kg:premio-de-seguro ;
    fl:hasTopic fl:t-seguros ;
    fl:relatedTo kg:livre-resolucao .

kg:seguro-de-grupo-nao-contributivo a fl:Product ;
    rdfs:label "seguro de grupo não contributivo"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/servi%C3%A7os/benefici%C3%A1rios-de-seguro-de-vida> ;
    fl:definition "Seguro onde as pessoas seguras nem sempre são identificadas individual e informaticamente."@pt ;
    fl:hasTopic fl:t-seguros .

kg:seguro-de-trabalhador-independente a fl:Product ;
    rdfs:label "seguro de trabalhadores independentes"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Seguro válido para trabalhadores independentes em Portugal e na União Europeia, com cobertura limitada a 15 dias, e com possibilidade de extensão para períodos maiores ou para países não Membros."@pt ;
