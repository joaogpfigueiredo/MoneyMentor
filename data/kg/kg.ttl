    fl:definition "Custos que devem ser incluídos no orçamento familiar ao avaliar o impacto do crédito à habitação."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:dado-atualizado a fl:Concept ;
    rdfs:label "dados atualizados"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/direitos-e-deveres-na-contratacao-de-credito> ;
    fl:definition "O cliente deve manter os seus dados atualizados e comunicar alterações de morada e outras circunstâncias relevantes."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:dado-pessoal a fl:Concept ;
    rdfs:label "dados pessoais"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/cuidados-gerais> ;
    fl:definition "Informações que podem ser utilizadas para fraudes, como documentos ou códigos de acesso."@pt ;
    fl:hasTopic fl:t-prevencao-fraude .

kg:declaracao-escrita a fl:Concept ;
    rdfs:label "declaração escrita"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Documento que comprova informações sobre os titulares de uma conta, necessário para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:decreto-lei-n-o-222-2009 a fl:Concept ;
    rdfs:label "Decreto-Lei n.º 222/2009"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/garantias> ;
    fl:definition "Legislação que obriga a instituição de crédito a informar a seguradora sobre a evolução do montante em dívida."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:denominacao a fl:Concept ;
    rdfs:label "denominação"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Nome de uma entidade ou pessoa coletiva, necessário para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:depositario a fl:Concept ;
    rdfs:label "depositário"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Instituição de crédito ou empresa de investimento autorizada para depositar títulos e documentos representativos dos valores mobiliários detidos pelo fundo de pensões."@pt ;
    fl:hasTopic fl:t-seguros .

kg:deposito-dual a fl:Product ;
    rdfs:label "depósito dual"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/poupar-e-investir> ;
    fl:definition "Produto bancário de poupança com diferentes rendibilidades e riscos, sujeito à supervisão do Banco de Portugal."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca,
        fl:t-custos-credito ;
    fl:regulatedBy fl:BancoDePortugal .

kg:deposito-indexado a fl:Product ;
    rdfs:label "depósito indexado"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/poupar-e-investir> ;
    fl:definition "Produto bancário de poupança com diferentes rendibilidades e riscos, sujeito à supervisão do Banco de Portugal."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca,
        fl:t-custos-credito ;
    fl:regulatedBy fl:BancoDePortugal .

kg:deposito-simple a fl:Product ;
    rdfs:label "depósito simples"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/poupar-e-investir> ;
    fl:definition "Produto bancário de poupança com diferentes rendibilidades e riscos, sujeito à supervisão do Banco de Portugal."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca,
        fl:t-custos-credito ;
    fl:regulatedBy fl:BancoDePortugal .

kg:diferimento-de-capital a fl:Concept ;
    rdfs:label "diferimento de capital"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-reembolsar-e-transferir> ;
    fl:definition "Adiamento do reembolso de parte do capital para o final do prazo do empréstimo, resultando em prestações constantes e mais baixas."@pt ;
    fl:hasTopic fl:t-emprestimos .

kg:direcao-geral-do-consumidor a fl:Concept ;
    rdfs:label "Direção-Geral do Consumidor"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/prevenir-fraude> ;
    fl:definition "Entidade a contactar em caso de fraude financeira."@pt ;
    fl:hasTopic fl:t-prevencao-fraude .

kg:direito-a-conversao-do-emprestimo a fl:Right ;
    rdfs:label "direito à conversão do empréstimo"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Direito do cliente à conversão do seu empréstimo quando a aquisição do grau de incapacidade igual ou superior a 60% ocorrer após a celebração do contrato."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:direito-a-devolucao-do-premio a fl:Right ;
    rdfs:label "direito à devolução do prémio"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-habita%C3%A7%C3%A3o> ;
    fl:definition "Direito do segurado à devolução da parte do prémio correspondente ao tempo restante do contrato, exceto se o contrato estabeleça algo diferente."@pt ;
    fl:hasTopic fl:t-seguros .

kg:direito-de-escolha-do-medico a fl:Right ;
    rdfs:label "direito de escolha do médico"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Direito do sinistrado de escolher o médico cirurgião em casos de intervenção cirúrgica de alto risco ou risco de vida."@pt ;
    fl:hasTopic fl:t-seguros .

kg:direito-de-obter-informacao a fl:Right ;
    rdfs:label "direito de obter informação"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/servi%C3%A7os/benefici%C3%A1rios-de-seguro-de-vida> ;
    fl:definition "Direito de qualquer interessado obter informação sobre contratos de seguro de vida, acidentes pessoais ou operações de capitalização após a morte do segurado ou subscritor."@pt ;
    fl:relatedTo kg:operacao-de-capitalizacao,
        kg:seguro-de-acidente-pessoal,
        kg:seguro-de-vida .

kg:direito-de-portabilidade a fl:Right ;
    rdfs:label "direito de portabilidade"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Direito do beneficiário de transferir o valor dos benefícios para outro fundo de pensões aberto de adesão individual."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:direito-de-regresso a fl:Right ;
    rdfs:label "direito de regresso"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Direito da entidade presumida como responsável a regressar contra a empresa de seguros do trabalhador independente ou contra o próprio trabalhador, se se provar que o acidente ocorreu em regime de trabalhador independente."@pt ;
    fl:hasTopic fl:t-seguros .

kg:direito-de-resolucao a fl:Right ;
    rdfs:label "direito de resolução"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Direito do participante de resolver o contrato de adesão individual a um fundo de pensões, com condições específicas de cessação."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:direito-de-reuniao a fl:Right ;
    rdfs:label "direito de reunião"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-acidentes-de-trabalho> ;
    fl:definition "Direito do trabalhador de se reunir ou manifestar em defesa dos seus interesses, incluso em caso de acidente de trabalho."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:distrate a fl:Concept ;
    rdfs:label "distrate"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-renegociar-ou-reembolsar-antecipadamente> ;
    fl:definition "Termo referente à hipoteca sobre um automóvel, como garantia real associada a um empréstimo."@pt ;
    fl:hasTopic fl:t-emprestimos .

kg:documento-comprovativo a fl:Concept ;
    rdfs:label "documento comprovativo"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Documento que comprova informações pessoais ou jurídicas, necessário para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:documento-de-informacao-sobre-comissao a fl:Concept ;
    rdfs:label "documento de informação sobre comissões"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Documento que apresenta informação sobre as comissões associadas aos serviços de pagamento."@pt ;
    fl:hasTopic fl:t-informacao-financeira ;
    fl:relatedTo kg:comissao-e-despesa,
        kg:conta-de-deposito-a-ordem .

kg:documento-equivalente-emitido-por-fonte-independente-e-credivel a fl:Concept ;
    rdfs:label "documento equivalente emitido por fonte independente e credível"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Documento que comprova a identidade de uma entidade com sede social fora do território nacional."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:educacao-dos-filho a fl:Concept ;
    rdfs:label "educação dos filhos"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/definir-objetivos> ;
    fl:definition "Custo associado ao ensino dos filhos, especialmente aos encargos do ensino superior."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:encargo a fl:Concept ;
    rdfs:label "encargos"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar>,
        <https://clientebancario.bportugal.pt/pt-pt/encargos> ;
    fl:definition "Cobranças feitas pelas instituições de crédito associadas à conta de depósito à ordem."@pt,
        "Encargos relativos à manutenção de contas, utilização de meios de pagamento e outros decorrentes do contrato de crédito."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:ensino-superior a fl:Concept ;
    rdfs:label "ensino superior"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/definir-objetivos> ;
    fl:definition "Formação académica com encargos mais elevados."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:entrega-da-apolice a fl:Concept ;
    rdfs:label "entrega da apólice"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Obrigatoriedade do segurador de entregar a apólice ao tomador do seguro no prazo estabelecido, ou em suporte eletrónico."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:erro-ou-omissao a fl:Concept ;
    rdfs:label "erro ou omissão"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Situação em que o tomador do seguro ou o segurado não informam corretamente ou completamente sobre o risco, podendo levar à anulação do contrato ou à cobertura parcial do sinistro."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:financa-pessoal a fl:Concept ;
    rdfs:label "finanças pessoais"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/definir-objetivos> ;
    fl:definition "Gestão das receitas e despesas com vista a atingir metas financeiras definidas."@pt ;
    fl:hasTopic fl:t-planeamento .

kg:formulario-de-informacao-ao-depositante a fl:Product ;
    rdfs:label "formulário de informação ao depositante"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/simples> ;
    fl:definition "Documento que informa sobre o sistema de garantia dos depósitos e os limites de proteção em caso de insolvência."@pt ;
    fl:regulatedBy fl:BancoDePortugal .

kg:franquia-de-seguro a fl:Cost ;
    rdfs:label "franquia de seguro"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-habita%C3%A7%C3%A3o> ;
    fl:definition "Parte do dano que o segurado deve pagar, com impacto no preço do seguro."@pt ;
    fl:hasTopic fl:t-seguros .

kg:franquia-inicial a fl:Cost ;
    rdfs:label "franquia inicial"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Valor que o segurado deve pagar antes de ser coberto pelo seguro para cada cobertura."@pt ;
    fl:hasTopic fl:t-seguros .

kg:fraude-em-ambiente-digital a fl:Risk ;
    rdfs:label "fraude em ambiente digital"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/w/asf-assinala-o-dia-mundial-da-poupan%C3%A7a-com-aulas-de-literacia-financeira> ;
    fl:definition "Risco associado à utilização de plataformas e serviços online, exigindo comportamentos prudentes."@pt ;
    fl:hasTopic fl:t-prevencao-fraude .

kg:fraude-em-valor-mobiliario a fl:Risk ;
    rdfs:label "fraude em valores mobiliários"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/produtos-de-investimento> ;
    fl:definition "Atividade que envolve ações ou obrigações e pode causar graves prejuízos aos investidores."@pt ;
    fl:hasTopic fl:t-prevencao-fraude .

kg:fundo-de-investimento-imobiliario a fl:Product ;
    rdfs:label "fundos de investimento imobiliário"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/fundos-de-investimento> ;
    fl:definition "Fundos cujo rendimento depende das condições do mercado imobiliário, como variações nos preços dos imóveis e no mercado de arrendamento."@pt ;
    fl:hasRisk kg:risco-de-mercado ;
    fl:hasTopic fl:t-aplicacoes-poupanca,
        fl:t-risco-incerteza .

kg:fundo-de-pensao-fechado a fl:Product ;
    rdfs:label "fundos de pensões fechado"@pt ;
    skos:altLabel "fundos de pensões fechados"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Fundos de pensões com apenas um associado (empregador), podendo ter mais se houver vínculo empresarial, associativo, profissional ou social entre eles."@pt,
        "Tipos de fundos de pensões que têm uma gestão específica e podem ter alterações regulamentadas por uma comissão de acompanhamento."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca ;
    fl:regulatedBy fl:ASF .

kg:fundo-reservado a fl:Concept ;
    rdfs:label "fundos reservados"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/elaborar-o-orcamento> ;
    fl:definition "Montantes guardados com antecedência para despesas futuras, como eletrodomésticos ou férias, para não afectar o equilíbrio do orçamento."@pt ;
    fl:hasTopic fl:t-planeamento .

kg:garantia-de-rendimento-ou-capital a fl:Concept ;
    rdfs:label "garantia de rendimento ou capital"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Forma de proteção que pode existir em alguns fundos de pensões, garantindo um rendimento ou capital mínimo ao participante."@pt ;
    fl:hasTopic fl:t-seguros .

kg:garantia-pessoal-do-estado-para-joven-ate-aos-35-ano a fl:Concept ;
    rdfs:label "garantia pessoal do Estado para jovens até aos 35 anos"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Regime especial que permite aos jovens até aos 35 anos beneficiar de uma garantia pública do Estado para financiar a aquisição da primeira habitação própria permanente, até 450 000 euros."@pt ;
    fl:hasTopic fl:t-emprestimos,
        fl:t-responsabilidades-credito ;
    fl:relatedTo kg:credito-a-habitacao .

kg:gestao-da-poupanca a fl:Concept ;
    rdfs:label "gestão da poupança"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/w/asf-assinala-o-dia-mundial-da-poupan%C3%A7a-com-aulas-de-literacia-financeira> ;
    fl:definition "Desafio de gerir a poupança em um contexto económico e digital em constante mudança."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:gestao-de-fundo a fl:Concept ;
    rdfs:label "gestão de fundos"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/fundos-de-investimento> ;
    fl:definition "Atividade de gestão dos fundos de investimento mobiliário, que pode ser subcontratada, mas com responsabilidade da entidade gestora perante os investidores."@pt ;
    fl:hasTopic fl:t-sistema-financeiro .

kg:grelha-de-referencia a fl:Concept ;
    rdfs:label "grelha de referência"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/direito-ao-esquecimento> ;
    fl:definition "Ferramenta que estabelece condições e prazos para o direito ao esquecimento, atualizada a cada dois anos."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:herdeiro a fl:Concept ;
    rdfs:label "herdeiro"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/titularidade-e-movimentacao> ;
    fl:definition "Pessoa que herda bens de um falecido, podendo ter acesso à conta de depósito se comprovar sua qualidade."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:hipoteca-sobre-um-automovel a fl:Concept ;
    rdfs:label "hipoteca sobre um automóvel"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-renegociar-ou-reembolsar-antecipadamente> ;
    fl:definition "Garantia real associada a um empréstimo, por exemplo, em casos de crédito automóvel."@pt ;
    fl:hasTopic fl:t-emprestimos .

kg:idade a fl:Concept ;
    rdfs:label "idade"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/avaliacao-da-solvabilidade> ;
    fl:definition "Elemento considerado na avaliação da solvabilidade do cliente bancário."@pt ;
    fl:hasTopic fl:t-necessidades-capacidades .

kg:identidade-do-beneficiario-efetivo a fl:Concept ;
    rdfs:label "identidade do beneficiário efetivo"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Informação e documentação sobre a identidade do terceiro que atua por conta de uma pessoa coletiva na abertura de conta bancária."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:imposto a fl:Cost ;
    rdfs:label "impostos"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar> ;
    fl:definition "Despesas suportadas pela instituição de crédito perante entidades da administração pública, que podem ser exigidas ao cliente em caso de reembolso antecipado."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:incapacidade-superior-a-60 a fl:Risk ;
    rdfs:label "incapacidade superior a 60%"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/direito-ao-esquecimento> ;
    fl:definition "Estado de deficiência ou risco agravado de saúde que pode influenciar o cálculo do prémio de seguro, mas que pode ser considerado para o direito ao esquecimento se for superado."@pt,
        "Nível de incapacidade psicológica, intelectual, fisiológica ou anatómica que, se superado, permite o exercício do direito ao esquecimento."@pt .

kg:incumprimento-de-contrato-de-credito a fl:Risk ;
    rdfs:label "incumprimento de contrato de crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-tipos-de-credito> ;
    fl:definition "Situação em que o cliente não cumpre as condições contratuais de um contrato de crédito, podendo levar à renegociação das condições ou à ação judicial."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:informacao-a-prestar a fl:Concept ;
    rdfs:label "informação a prestar"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0> ;
    fl:definition "Informação que deve ser prestada ao cliente bancário sobre situações de incumprimento, regularização ou reembolso antecipado, através do extrato ou documento autónomo no prazo de 15 dias."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:informacao-e-documento-solicitado a fl:Concept ;
    rdfs:label "informação e documentos solicitados"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/direitos-e-deveres-na-contratacao-de-credito> ;
    fl:definition "Informação e documentos que o cliente deve fornecer à instituição de crédito sobre os seus rendimentos e despesas."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:informacao-economica a fl:Concept ;
    rdfs:label "informação económica"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/direitos-e-deveres-na-contratacao-de-credito> ;
    fl:definition "Informações que o cliente deve fornecer à instituição de crédito para avaliar o risco do empréstimo."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:informacao-legal-e-contratual a fl:Concept ;
    rdfs:label "informação legal e contratuais"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Disposições legais e contratuais que devem ser fundamentadas e comunicadas ao reclamante no resultado da apreciação da reclamação."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:informacao-sobre-comissao a fl:Concept ;
    rdfs:label "informação sobre comissões"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/direitos-e-deveres-na-contratacao-de-depositos> ;
    fl:definition "Documento que apresenta as comissões dos serviços mais representativos associados à conta de pagamento."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:informacao-sobre-fundo-de-pensao a fl:Concept ;
    rdfs:label "informação sobre fundos de pensões"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Dados que as entidades gestoras devem fornecer aos participantes, incluindo opções de investimento, características do plano de pensões e fatores de sustentabilidade."@pt ;
    fl:relatedTo kg:informacao-gratuita .

kg:intermediario-de-credito-a-titulo-acessorio a fl:Concept ;
    rdfs:label "intermediário de crédito a título acessório"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/intermediarios-de-credito-o-que-sao> ;
    fl:definition "Pessoa que fornece bens ou serviços e, em nome e sob responsabilidade total e incondicional do mutuante, atua como intermediário de crédito para venda dos bens ou prestação dos serviços."@pt ;
    fl:hasTopic fl:t-sistema-financeiro .

kg:intermediario-de-credito-nao-vinculado a fl:Concept ;
    rdfs:label "intermediário de crédito não vinculado"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/intermediarios-de-credito-o-que-sao> ;
    fl:definition "Pessoa coletiva que atua como intermediário de crédito sem ter celebrado contrato de vinculação com nenhum mutuante, celebrando um contrato de intermediação de crédito com o consumidor."@pt ;
    fl:hasTopic fl:t-sistema-financeiro .

kg:intermediario-de-credito-vinculado a fl:Concept ;
    rdfs:label "intermediário de crédito vinculado"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/intermediarios-de-credito-o-que-sao> ;
    fl:definition "Pessoa que atua como intermediário de crédito em nome e sob responsabilidade total e incondicional do mutuante ou de vários mutuantes com quem tenha celebrado contrato de vinculação."@pt ;
    fl:hasTopic fl:t-sistema-financeiro .

kg:investidor-arrojado a fl:Concept ;
    rdfs:label "investidor arrojado"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/perfil-do-investidor> ;
    fl:definition "Investidor que procura produtos com rendibilidade mais elevada, estando disponível para aplicações com horizonte temporal mais curto e assumir risco de perda total ou superior do capital."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:investidor-conservador-ou-prudente a fl:Concept ;
    rdfs:label "investidor conservador ou prudente"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/perfil-do-investidor> ;
    fl:definition "Investidor que procura produtos com garantia do capital e rendibilidade compatível com taxas de juro de curto prazo, sendo avesso aos riscos de capital, rendimento e liquidez."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:investidor-dinamico a fl:Concept ;
    rdfs:label "investidor dinâmico"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/perfil-do-investidor> ;
    fl:definition "Investidor que procura rendibilidade superior à média do mercado, estando disponível para aplicações de médio e longo prazo e assumir risco de algumas perdas no capital."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:investidor-equilibrado-ou-moderado a fl:Concept ;
    rdfs:label "investidor equilibrado ou moderado"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/perfil-do-investidor> ;
    fl:definition "Investidor que procura produtos com garantia do capital, mas está disposto a assumir prazo mais longo para aceitar eventual oscilação adversa do rendimento."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:julgado-de-paz a fl:Right ;
    rdfs:label "julgados de paz"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/servi%C3%A7os/reclama%C3%A7%C3%B5es/meios-de-resolu%C3%A7%C3%A3o-de-lit%C3%ADgios> ;
    fl:definition "Instituições que podem intervir em causas que não excedam os 15 000,00 €."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:juro-remuneratorio a fl:Concept ;
    rdfs:label "juros remuneratórios"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/atraso-no-pagamento> ;
    fl:definition "Juros pagos pelo cliente bancário à instituição de crédito por disponibilizar os fundos emprestados."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:juro-vencido a fl:Cost ;
    rdfs:label "juros vencidos"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/contratacao-distancia> ;
    fl:definition "Juros que o cliente deve pagar à instituição no prazo de 30 dias após a notificação de livre resolução, calculados com base na taxa de juro anual nominal do contrato."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:leasing a fl:Product ;
    rdfs:label "leasing"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/credito-automovel> ;
    fl:definition "Modalidade de crédito automóvel que pode ser optada pelo consumidor, com características diferentes das taxas máximas aplicáveis."@pt ;
    fl:hasTopic fl:t-emprestimos .

kg:menor a fl:Concept ;
    rdfs:label "menor"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/titularidade-e-movimentacao> ;
    fl:definition "Pessoa com idade inferior à maioridade legal, que pode ser titular de conta de depósito."@pt ;
    fl:hasTopic fl:t-necessidades-capacidades .

kg:ministerio-publico a fl:Concept ;
    rdfs:label "Ministério Público"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/prevenir-fraude> ;
    fl:definition "Entidade a contactar em caso de fraude financeira."@pt ;
    fl:hasTopic fl:t-prevencao-fraude .

kg:montante-final-da-poupanca a fl:Concept ;
    rdfs:label "montante final da poupança"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/en/simulador-da-poupanca> ;
    fl:definition "Valor total acumulado ao fim do período de poupança."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:montante-maximo-de-emprestimo a fl:Concept ;
    rdfs:label "montante máximo de empréstimo"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Limite máximo de 238 273,23 euros (atualizado anualmente) para a mudança para o regime de crédito para pessoas com deficiência."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:morada-da-sede-social a fl:Concept ;
    rdfs:label "morada da sede social"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Endereço principal de uma entidade, necessário para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:morada-de-domicilio-fiscal a fl:Concept ;
    rdfs:label "morada de domicílio fiscal"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Endereço onde a pessoa ou entidade realiza suas atividades financeiras, necessário para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:morada-de-residencia-permanente a fl:Concept ;
    rdfs:label "morada de residência permanente"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Endereço onde a pessoa reside de forma contínua, necessário para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:mudanca-de-conta-para-o-estrangeiro a fl:Concept ;
    rdfs:label "mudança de conta para o estrangeiro"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/mudanca-de-conta> ;
    fl:definition "Mudança de conta para um prestador de serviços de pagamento situado em outro Estado-Membro da União Europeia, com procedimentos específicos."@pt ;
    fl:hasTopic fl:t-contas-bancarias .

kg:nacionalidade a fl:Concept ;
    rdfs:label "nacionalidade"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Pertencimento a uma nação, necessária para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:nao-renovacao-do-contrato a fl:Risk ;
    rdfs:label "não renovação do contrato"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Situação em que o contrato de seguro não é renovado, podendo levar a recusas de prestações em alguns casos."@pt ;
    fl:hasTopic fl:t-seguros .

kg:naturalidade a fl:Concept ;
    rdfs:label "naturalidade"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Origem nacional de uma pessoa, necessária para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:numerario a fl:Concept ;
    rdfs:label "numerário"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/numerario> ;
    fl:definition "Meio de pagamento constituído por notas e moedas metálicas, que é universal e de aceitação obrigatória."@pt ;
    fl:hasTopic fl:t-meios-pagamento ;
    fl:relatedTo kg:fraude,
        kg:troca-de-nota-deteriorada .

kg:numero-de-identificacao-de-pessoa-coletiva a fl:Concept ;
    rdfs:label "número de identificação de pessoa coletiva"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Identificador único atribuído a uma entidade, necessário para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:objetivo-de-poupanca a fl:Concept ;
    rdfs:label "objetivo de poupança"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/en/simulador-da-poupanca> ;
    fl:definition "Metas definidas para acumular um determinado montante em poupança."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:objeto a fl:Concept ;
    rdfs:label "objeto"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Finalidade ou atividade de uma entidade, necessário para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:operacao-de-capitalizacao a fl:Product ;
    rdfs:label "operacao de capitalizacao"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/servi%C3%A7os/benefici%C3%A1rios-de-seguro-de-vida> ;
    fl:definition "Operação financeira que permite acumular capital, podendo estar associada a seguros de vida."@pt ;
    fl:regulatedBy fl:ASF .

kg:orgao-de-administracao a fl:Concept ;
    rdfs:label "órgão de administração"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Estrutura responsável pela gestão de uma entidade, necessária para a identificação dos titulares."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:outro-credito-pessoal a fl:Concept ;
    rdfs:label "outros créditos pessoais"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro-no-credito-aos-consumidores> ;
    fl:definition "Créditos destinados à aquisição de bens e serviços não incluídos nas subcategorias anteriores, nomeadamente mobiliário e equipamentos para o lar."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-responsabilidades-credito ;
    fl:relatedTo kg:taeg-maxima .

kg:participacao-no-capital a fl:Concept ;
    rdfs:label "participações no capital"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Participação em capital de uma entidade, necessária para a identificação dos titulares."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:passaporte a fl:Concept ;
    rdfs:label "passaporte"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Documento oficial que identifica uma pessoa física, necessário para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:patologia-oncologica a fl:Concept ;
    rdfs:label "patologia oncológica"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/direito-ao-esquecimento> ;
    fl:definition "Doença relacionada com o câncer, que pode ter prazos específicos para o direito ao esquecimento."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:pedido-de-mudanca-de-conta a fl:Concept ;
    rdfs:label "pedido de mudança de conta"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/mudanca-de-conta> ;
    fl:definition "Solicitação formal, por escrito, ao prestador de destino para efetuar a mudança de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:penalizacao-adicional a fl:Cost ;
    rdfs:label "penalização adicional"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/planos-de-poupanca> ;
    fl:definition "Sanção prevista nas condições contratuais, além da penalização fiscal, aplicada ao participante que retira o montante antes da data prevista."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:penalizacao-fiscal a fl:Cost ;
    rdfs:label "penalização fiscal"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/planos-de-poupanca> ;
    fl:definition "Sanção aplicada ao participante que retira o montante antes da data prevista, exigindo a devolução dos benefícios fiscais obtidos."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:pensao-de-sobrevivencia a fl:Concept ;
    rdfs:label "pensão de sobrevivência"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Situação que pode conferir direito ao recebimento dos benefícios dos fundos de pensões."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:peso-das-despesa a fl:Concept ;
    rdfs:label "peso das despesas"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/identificar-rendimentos-e-despesas> ;
    fl:definition "Percentual de cada tipo de despesa no orçamento familiar, que influencia a capacidade de ajustar o orçamento em caso de queda do rendimento."@pt ;
    fl:hasTopic fl:t-despesas-rendimentos ;
    fl:relatedTo kg:despesa-fixa,
        kg:rendimento .

kg:plafond a fl:Concept ;
    rdfs:label "plafond"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e>,
        <https://www.todoscontam.pt/pt-pt/cartao-de-credito> ;
    fl:definition "Limite máximo de crédito atribuído ao cliente no cartão de crédito."@pt,
        "Limite máximo de crédito disponibilizado pela instituição de crédito através do cartão de crédito."@pt .

kg:poupanca-inicial a fl:Concept ;
    rdfs:label "poupança inicial"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/en/simulador-da-poupanca> ;
    fl:definition "Montante inicial que se deposita na poupança antes de aplicar reforços."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:poupanca-regular a fl:Concept ;
    rdfs:label "poupança regular"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/en/simulador-da-poupanca> ;
    fl:definition "Poupança feita com reforços periódicos, mensais ou anuais."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:prazo-de-13-dia-utel a fl:Concept ;
    rdfs:label "prazo de 13 dias úteis"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/mudanca-de-conta> ;
    fl:definition "Prazo mínimo para a execução das operações na nova conta após a data indicada no pedido de mudança de conta."@pt ;
    fl:hasTopic fl:t-contas-bancarias .

kg:prazo-de-20-dia-utel a fl:Concept ;
    rdfs:label "prazo de 20 dias úteis"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/provedor-seguros> ;
    fl:definition "Prazo máximo para que uma empresa de seguros responda a uma reclamação ou para que o provedor analise uma reclamação."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:prazo-de-30-dia-utel a fl:Concept ;
    rdfs:label "prazo de 30 dias úteis"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/provedor-seguros> ;
    fl:definition "Prazo máximo para que o provedor analise uma reclamação, podendo ser prorrogado para 45 dias em casos de especial complexidade."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:prazo-de-45-dia-utel a fl:Concept ;
    rdfs:label "prazo de 45 dias úteis"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/provedor-seguros> ;
    fl:definition "Prazo máximo prorrogado para análise de reclamações de especial complexidade pelo provedor de seguros."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:prazo-maximo-de-20-dia-utel a fl:Concept ;
    rdfs:label "prazo máximo de 20 dias úteis"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/provedor-fundos-de-pens%C3%B5es> ;
    fl:definition "Prazo máximo para resposta da entidade gestora às reclamações ou para a entidade gestora informar se aceita as recomendações do provedor."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:prazo-maximo-de-30-dia-utel a fl:Concept ;
    rdfs:label "prazo máximo de 30 dias úteis"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/provedor-fundos-de-pens%C3%B5es> ;
    fl:definition "Prazo máximo para análise das reclamações pelo provedor, prorrogado para 45 dias em casos de especial complexidade."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:prazo-maximo-de-emprestimo a fl:Concept ;
    rdfs:label "prazo máximo de empréstimo"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "A soma dos prazos dos dois empréstimos não pode exceder 50 anos."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:pre-reforma a fl:Concept ;
    rdfs:label "pré-reforma"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Situação que pode conferir direito ao recebimento dos benefícios dos fundos de pensões."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:prestacao a fl:Concept ;
    rdfs:label "prestação"@pt ;
    skos:altLabel "prestações"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-reembolsar-e-transferir>,
        <https://www.todoscontam.pt/pt-pt/contrair-credito>,
        <https://www.todoscontam.pt/pt-pt/gerir-dividas> ;
    fl:definition "Despesa fixa no orçamento associada ao crédito, com impacto no esforço financeiro mensal da família."@pt,
        "Pagamento mensal do empréstimo, que inclui capital e juros, efetuado através do débito em conta."@pt,
        "Pagamentos mensais que o consumidor deve efectuar para saldar o crédito."@pt ;
    fl:hasTopic fl:t-emprestimos .

kg:produto-financeiro a fl:Concept ;
    rdfs:label "produto financeiro"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/responsabilidades-de-credito> ;
    fl:definition "Produto a que corresponde o contrato de crédito, como crédito pessoal, crédito automóvel ou crédito à habitação."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:profissao-e-entidade-patronal a fl:Concept ;
    rdfs:label "profissão e entidade patronal"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Informação sobre o trabalho e a entidade empregadora, necessária para a abertura de conta."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:proposta-de-adesao a fl:Concept ;
    rdfs:label "proposta de adesão"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Documento através do qual o tomador do seguro expressa a sua vontade de celebrar um contrato de seguro e informa o segurador do risco que pretende segurar."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:protecao-dos-dado-pessoal a fl:Concept ;
    rdfs:label "proteção dos dados pessoais"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/prevenir-fraude> ;
    fl:definition "Cuidados gerais a ter para evitar a apropriação indevida de dados pessoais."@pt ;
    fl:hasTopic fl:t-prevencao-fraude .

kg:protocolo-terapeutico a fl:Concept ;
    rdfs:label "protocolo terapêutico"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/direito-ao-esquecimento> ;
    fl:definition "Conjunto de orientações utilizadas por profissionais de saúde para planear e implementar tratamentos eficazes para diversas condições clínicas."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:provedor a fl:Concept ;
    rdfs:label "provedor"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Entidade responsável por analisar reclamações apresentadas pelos participantes e beneficiários dos fundos de pensões."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:publicidade-de-seguro a fl:Concept ;
    rdfs:label "publicidade de seguro"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/contrato-de-seguro> ;
    fl:definition "Mensagem promocional feita pelo segurador que deve ser respeitada no contrato, salvo exceções previstas."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:questionario a fl:Concept ;
    rdfs:label "questionário"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/direito-ao-esquecimento> ;
    fl:definition "Ferramenta utilizada na declaração inicial do risco para obter informações sobre a situação de saúde do segurado."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:racio-financeiro-de-garantia a fl:Concept ;
    rdfs:label "rácio financeiro de garantia"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Relação entre o capital em dívida e o valor do imóvel, que não pode ultrapassar 90%."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:reavaliacao-de-imovel a fl:Concept ;
    rdfs:label "reavaliação de imóvel"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/garantias> ;
    fl:definition "Processo de reavaliação do imóvel por iniciativa da instituição de crédito, em cumprimento de normas legais ou regulamentares."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-emprestimos ;
    fl:relatedTo kg:segunda-avaliacao .

kg:recomendacao a fl:Concept ;
    rdfs:label "recomendações"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/provedor-fundos-de-pens%C3%B5es> ;
    fl:definition "Recomendações feitas pelo provedor à entidade gestora após análise de reclamações, que esta deve considerar ou não."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:recomendacao-do-provedor a fl:Concept ;
    rdfs:label "recomendações do provedor"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Sugestões feitas pelo provedor às entidades gestoras de fundos de pensões, que devem ser comunicadas ao reclamante e à entidade gestora."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:rede-de-apoio-ao-cliente-bancario a fl:Concept ;
    rdfs:label "rede de apoio ao cliente bancário"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/gerir-dividas> ;
    fl:definition "Rede constituída por centros de informação e arbitragem de conflitos de consumo e outras entidades formalmente reconhecidas pela Direção-Geral do Consumidor."@pt ;
    fl:hasTopic fl:t-informacao-financeira,
        fl:t-prevencao-fraude ;
    fl:relatedTo kg:apoio-gratuito .

kg:reducao-do-nivel-de-rendimento-apo-a-reforma a fl:Risk ;
    rdfs:label "redução do nível de rendimento após a reforma"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/avaliacao-da-solvabilidade> ;
    fl:definition "Circunstância futura que pode impactar a capacidade do cliente bancário para cumprir as obrigações de um contrato de crédito."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:reembolso-antecipado-do-contrato-de-credito a fl:Right ;
    rdfs:label "reembolso antecipado do contrato de crédito"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/como-contratar-0> ;
    fl:definition "Direito do consumidor de reembolsar antecipadamente o contrato de crédito, com informação prestada através do extrato ou documento autónomo no prazo de 15 dias."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-responsabilidades-credito ;
    fl:relatedTo kg:informacao-a-prestar .

kg:reembolso-do-valor-das-contribuicao a fl:Right ;
    rdfs:label "reembolso do valor das contribuições"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Direito do participante de receber o valor das contribuições em certas situações, como extinção do fundo ou outros eventos previstos."@pt ;
    fl:hasTopic fl:t-prevencao-fraude .

kg:reembolso-em-capital a fl:Right ;
    rdfs:label "reembolso em capital"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Direito do beneficiário de solicitar o reembolso em capital do valor correspondente aos seus direitos adquiridos, desde que previsto no contrato e o montante do capital seja inferior ao dobro da retribuição mínima mensal garantida."@pt ;
    fl:hasTopic fl:t-responsabilidades-credito .

kg:reforco-anual a fl:Concept ;
    rdfs:label "reforços anuais"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/en/simulador-da-poupanca> ;
    fl:definition "Adições periódicas à poupança, feitas anualmente."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:reforco-mensal a fl:Concept ;
    rdfs:label "reforços mensais"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/en/simulador-da-poupanca> ;
    fl:definition "Adições periódicas à poupança, feitas mensalmente."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:reforma a fl:Concept ;
    rdfs:label "reforma"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/definir-objetivos> ;
    fl:definition "Acúmulo de fundos para garantir rendimento futuro."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:reforma-antecipada a fl:Concept ;
    rdfs:label "reforma antecipada"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Situação que pode conferir direito ao recebimento dos benefícios dos fundos de pensões."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:reforma-por-invalidez a fl:Concept ;
    rdfs:label "reforma por invalidez"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Situação que pode conferir direito ao recebimento dos benefícios dos fundos de pensões."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:reforma-por-velhice a fl:Concept ;
    rdfs:label "reforma por velhice"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Situação que pode conferir direito ao recebimento dos benefícios dos fundos de pensões."@pt ;
    fl:hasTopic fl:t-objetivos-poupanca .

kg:regime-de-credito-para-deficiente-das-forca-armada a fl:Product ;
    rdfs:label "regime de crédito para deficientes das forças armadas"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/o-que-e-e-diferentes-regimes> ;
    fl:definition "Regime especial de crédito para deficientes das forças armadas com grau de incapacidade igual ou superior a 60%."@pt ;
    fl:hasTopic fl:t-emprestimos,
        fl:t-responsabilidades-credito ;
    fl:relatedTo kg:seguranca-de-credito-para-deficiente-das-forca-armada .

kg:regra-de-identificacao a fl:Concept ;
    rdfs:label "regras de identificação"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/abertura> ;
    fl:definition "Elementos exigidos aos titulares de conta de depósito no estrangeiro, conforme as regras do país onde a instituição está sediada."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:regra-proporcional a fl:Concept ;
    rdfs:label "regra proporcional"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-habita%C3%A7%C3%A3o> ;
    fl:definition "Aplica-se quando o capital seguro é inferior ao custo de reconstrução ou substituição, limitando a indemnização à proporção entre o capital seguro e o custo real."@pt ;
    fl:hasTopic fl:t-seguros .

kg:regulamento-de-gestao a fl:Concept ;
    rdfs:label "regulamento de gestão"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/poupan%C3%A7a/fundos-de-pens%C3%B5es> ;
    fl:definition "Documento que define as regras e condições de gestão dos fundos de pensões."@pt ;
    fl:hasTopic fl:t-informacao-financeira .

kg:relatorio-de-avaliacao a fl:Cost ;
    rdfs:label "relatório de avaliação"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/garantias> ;
    fl:definition "Documento resultante da avaliação de imóvel, que pode ser solicitado pelo consumidor e deve ser disponibilizado pela instituição de crédito."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-emprestimos ;
    fl:relatedTo kg:reclamacao .

kg:rendimento-e-despesa-regular a fl:Concept ;
    rdfs:label "rendimentos e despesas regulares"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/avaliacao-da-solvabilidade> ;
    fl:definition "Elemento considerado na avaliação da solvabilidade do cliente bancário."@pt ;
    fl:hasTopic fl:t-necessidades-capacidades .

kg:rendimento-liquido-do-agregado-familiar a fl:Concept ;
    rdfs:label "rendimento líquido do agregado familiar"@pt ;
    prov:wasDerivedFrom <https://www.todoscontam.pt/pt-pt/determinar-situacao-financeira> ;
