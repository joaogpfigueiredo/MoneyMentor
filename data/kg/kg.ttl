    fl:definition "Taxa que inclui todos os encargos associados ao produto financeiro."@pt,
        "Taxa que reflete a realidade dos juros compostos em depósitos a prazo."@pt ;
    fl:hasTopic fl:t-aplicacoes-poupanca .

kg:taxa-anual-efetiva-liquida-tael a fl:Concept ;
    rdfs:label "taxa anual efetiva líquida (TAEL)"@pt ;
    prov:wasDerivedFrom <https://clientebancario.bportugal.pt/pt-pt/taxas-de-juro> ;
