        "Encargo que o cliente em incumprimento fica sujeito ao pagamento, acrescido à sua dívida."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:linha-de-credito a fl:Product ;
    rdfs:label "linhas de crédito"@pt ;
