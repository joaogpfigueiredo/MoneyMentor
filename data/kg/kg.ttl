    fl:definition "Processo realizado pelo intermediário financeiro para avaliar se um produto é adequado ao perfil de risco do investidor, através de um questionário."@pt ;
    fl:hasTopic fl:t-informacao-financeira,
        fl:t-responsabilidades-credito .

kg:titular-falecido a fl:Concept ;
