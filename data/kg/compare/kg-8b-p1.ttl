kg:limites-de-capital a fl:Concept ;
    rdfs:label "limites de capital"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Quantia máxima coberta por cada cobertura no seguro de saúde."@pt ;
    fl:hasTopic fl:t-seguros .

kg:declaracao-de-estado-de-saude a fl:Concept ;
    rdfs:label "declaração de estado de saúde"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Obrigatoriedade do segurado ou tomador do seguro de informar a empresa de seguros sobre doenças preexistentes."@pt ;
    fl:hasTopic fl:t-informacao-financeira,
        fl:t-seguros .

kg:nao-renovacao-do-contrato a fl:Risk ;
    rdfs:label "não renovação do contrato"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Situação em que o contrato de seguro não é renovado, podendo levar a recusas de prestações em alguns casos."@pt ;
    fl:hasTopic fl:t-risco-incerteza ;
    fl:relatedTo kg:seguro-de-saude .

kg:plano-de-saude a fl:Product ;
    rdfs:label "plano de saúde"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Produto que permite ao cliente aceder a um conjunto de serviços de saúde a um valor mais reduzido, sem assumir risco por parte da entidade gestora."@pt ;
    fl:hasTopic fl:t-seguros ;
    fl:regulatedBy fl:ASF .

kg:prestador-de-servicos a fl:Concept ;
    rdfs:label "prestador de serviços"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Profissional ou entidade que presta cuidados de saúde, podendo estar convencionado com a empresa de seguros."@pt ;
    fl:hasTopic fl:t-informacao-financeira,
        fl:t-seguros .

kg:capital-disponivel a fl:Concept ;
    rdfs:label "capital disponível"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Quantia disponível para cada cobertura no seguro de saúde."@pt ;
    fl:hasTopic fl:t-seguros .

kg:exclusao-de-cobertura a fl:Concept ;
    rdfs:label "exclusão de cobertura"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Listagem de situações que o seguro de saúde não cobre, como doenças profissionais, tratamentos estéticos, etc."@pt ;
    fl:hasTopic fl:t-risco-incerteza .

kg:pagamento-direto a fl:Cost ;
    rdfs:label "pagamento direto"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Pagamento pelos prestadores dos serviços de saúde, sem intervenção do segurado."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:periodo-de-carencia a fl:Concept ;
    rdfs:label "período de carência"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Período durante o qual o segurado não é coberto por uma nova cobertura após a mudança de seguro."@pt,
        "Período máximo de um ano durante o qual doenças preexistentes não estão cobertas pelo seguro."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-seguros .

kg:prazo-maximo-para-entrega-do-pedido-de-pagamento a fl:Concept ;
    rdfs:label "prazo máximo para entrega do pedido de pagamento"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Prazo máximo para entrega do pedido de pagamento das despesas, contado a partir da data em que foram realizadas."@pt ;
    fl:hasTopic fl:t-seguros .

kg:prazo-maximo-para-reembolsar-a-pessoa-segura a fl:Concept ;
    rdfs:label "prazo máximo para reembolsar a pessoa segura"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Prazo máximo para reembolsar a pessoa segura após a realização de despesas médicas."@pt ;
    fl:hasTopic fl:t-seguros .

kg:reembolso a fl:Cost ;
    rdfs:label "reembolso"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Pagamento ao tomador do seguro ou segurado de despesas realizadas com cuidados de saúde."@pt ;
    fl:hasTopic fl:t-custos-credito .

kg:autorizacao-previa a fl:Concept ;
    rdfs:label "autorização prévia"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Aprovação prévia dada pelos serviços clínicos da empresa de seguros para acesso a cuidados de saúde garantidos."@pt ;
    fl:hasTopic fl:t-planeamento,
        fl:t-seguros .

kg:franquia-inicial a fl:Cost ;
    rdfs:label "franquia inicial"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Valor que o segurado deve pagar antes de ser coberto pelo seguro para cada cobertura."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-seguros .

kg:internamento-hospitalar a fl:Concept ;
    rdfs:label "internamento hospitalar"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Tratamento em ambiente hospitalar, que pode exigir autorização prévia da empresa de seguros."@pt ;
    fl:hasTopic fl:t-risco-incerteza,
        fl:t-seguros .

kg:sistema-de-pagamento-direto a fl:Concept ;
    rdfs:label "sistema de pagamento direto"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Sistema em que a empresa de seguros paga diretamente aos prestadores de serviços convencionados."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-seguros .

kg:sistema-de-reembolso a fl:Concept ;
    rdfs:label "sistema de reembolso"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Sistema em que o segurado paga as despesas diretamente aos prestadores e depois é reembolsado pela empresa de seguros."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-seguros .

kg:doenca-preexistente a fl:Concept ;
    rdfs:label "doença preexistente"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Circunstância clínica presente antes da data de início do seguro, com diagnóstico inequívoco e conhecimento prévio do segurado."@pt,
        "Doenças conhecidas do segurado à data da celebração do contrato, que podem estar cobertas se não excluídas expressamente."@pt ;
    fl:hasTopic fl:t-risco-incerteza,
        fl:t-seguros .

kg:comparticipacao a fl:Concept ;
    rdfs:label "comparticipação"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Parte das despesas de saúde coberta por um sistema de segurança social, que o seguro de saúde complementa."@pt,
        "Percentagens máximas pagas pela empresa de seguros, que correspondem à parte da despesa que o segurado não cobre."@pt ;
    fl:hasTopic fl:t-custos-credito,
        fl:t-informacao-financeira,
        fl:t-seguros .

kg:seguro-de-saude a fl:Product ;
    rdfs:label "seguro de saúde"@pt ;
    skos:altLabel "seguro saúde"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Contrato que cobre despesas médicas, com diferentes coberturas e condições de pagamento."@pt,
        "Contrato que cobre doenças preexistentes, se não excluídas expressamente, e pode incluir período de carência e obrigações de declaração de estado de saúde."@pt ;
    fl:hasCost kg:franquia-inicial,
        kg:pagamento-direto,
        kg:reembolso ;
    fl:hasTopic fl:t-seguros ;
    fl:regulatedBy fl:ASF ;
    fl:relatedTo kg:autorizacao-previa,
        kg:capital-disponivel,
        kg:comparticipacao,
        kg:doenca-preexistente,
        kg:exclusao-de-cobertura,
        kg:internamento-hospitalar,
        kg:prazo-maximo-para-entrega-do-pedido-de-pagamento,
        kg:prazo-maximo-para-reembolsar-a-pessoa-segura,
        kg:sistema-de-pagamento-direto,
        kg:sistema-de-reembolso .

