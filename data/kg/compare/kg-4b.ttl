kg:capital-disponivel-para-cada-cobertura a fl:Concept ;
    rdfs:label "capital disponível para cada cobertura"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Valor disponível para cada cobertura do seguro de saúde."@pt .

kg:comparticipacao-de-sistema-de-seguranca-social a fl:Concept ;
    rdfs:label "comparticipação de sistema de segurança social"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Parte das despesas de saúde que é compartilhada com um sistema de segurança social, sendo coberta apenas a parte não comparticipada pelo seguro."@pt .

kg:informacao-da-doenca a fl:Concept ;
    rdfs:label "informação da doença"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Informação da doença que deve ser comunicada à empresa de seguros nos 30 dias imediatos ao termo do contrato."@pt .

kg:pagamento-direto-pela-empresa-de-seguros a fl:Concept ;
    rdfs:label "pagamento direto pela empresa de seguros"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Sistema em que o segurado paga apenas a parte não coberta pelo seguro, e a empresa de seguros paga diretamente aos prestadores de serviços."@pt .

kg:percentagem-maxima-de-comparticipacao a fl:Concept ;
    rdfs:label "percentagem máxima de comparticipação"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Percentagem pagas pela empresa de seguros, que é calculada em função das coberturas contratadas."@pt .

kg:prazo-maximo-para-entrega-do-pedido-de-pagamento a fl:Concept ;
    rdfs:label "prazo máximo para entrega do pedido de pagamento"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Prazo máximo para entregar o pedido de pagamento das despesas, contado a partir da data em que foram realizadas."@pt .

kg:prazo-maximo-para-reembolso a fl:Concept ;
    rdfs:label "prazo máximo para reembolso"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Prazo máximo para reembolsar a pessoa segura após as despesas."@pt .

kg:regra-de-nao-recusa-de-prestacoes a fl:Concept ;
    rdfs:label "regra de não recusa de prestações"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Regra que permite que a empresa de seguros não recuse prestações de saúde se não estiverem cobertas por um contrato posterior."@pt .

kg:valor-da-franquia-inicial a fl:Concept ;
    rdfs:label "valor da franquia inicial"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Valor inicial que o segurado deve pagar por cada cobertura, se existir."@pt .

kg:sistema-de-pagamento-direto a fl:Concept ;
    rdfs:label "sistema de pagamento direto"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Sistema em que a empresa de seguros paga diretamente aos prestadores de serviços com acordo, evitando despesas do segurado."@pt ;
