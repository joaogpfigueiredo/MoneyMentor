kg:doencas-preexistentes a fl:Concept ;
    rdfs:label "doenças preexistentes"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
    fl:definition "Circunstância clínica presente, suportada num diagnóstico inequívoco, cuja natureza dos sinais e sintomas deveriam ser do conhecimento prévio do segurado, que não ignorou ou já recebeu aviso médico/tratamento antes do início do seguro."@pt,
        "Doenças conhecidas do segurado à data do contrato, que são cobertas pelo seguro se não forem excluídas expressamente."@pt ;
    fl:hasTopic fl:t-necessidades-desejos .

kg:limites-de-capital a fl:Concept ;
    rdfs:label "limites de capital"@pt ;
    prov:wasDerivedFrom <https://www.consumidor.asf.com.pt/seguros/seguro-de-sa%C3%BAde> ;
